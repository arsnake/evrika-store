{{ header }}
<link rel="stylesheet" href="catalog/view/theme/evrika/stylesheet/auth.css">

<main>
<div class="wrap">

<nav class="breadcrumb" aria-label="Хлебные крошки">
  {% for breadcrumb in breadcrumbs %}
    {% if loop.first %}
      <a href="{{ breadcrumb.href }}">Главная</a>
    {% else %}
      <span class="bc-sep">›</span>
      {% if loop.last %}
        <span class="bc-current">{{ breadcrumb.text }}</span>
      {% else %}
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      {% endif %}
    {% endif %}
  {% endfor %}
</nav>

<div class="auth-layout">

  <!-- ── ФОРМА ── -->
  <div class="auth-card">

    {% if success %}

      <!-- ══ ПИСЬМО ОТПРАВЛЕНО ══ -->
      <div class="auth-card-head">
        <div class="auth-logo-mark" style="background: var(--primary);">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" width="22" height="22"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <h1 class="auth-title">Письмо отправлено</h1>
        <p class="auth-sub">Ссылка для сброса пароля отправлена на ваш email</p>
      </div>

      <div class="forgot-sent-info">
        <div class="forgot-sent-step">
          <div class="forgot-sent-num">1</div>
          <span>Откройте ваш почтовый ящик <strong>{{ email }}</strong></span>
        </div>
        <div class="forgot-sent-step">
          <div class="forgot-sent-num">2</div>
          <span>Найдите письмо от нас с темой «Восстановление пароля»</span>
        </div>
        <div class="forgot-sent-step">
          <div class="forgot-sent-num">3</div>
          <span>Перейдите по ссылке в письме и задайте новый пароль</span>
        </div>
      </div>

      <p class="forgot-resend-hint">Не получили письмо? Проверьте папку «Спам» или
        <a class="auth-link" href="{{ action }}">попробуйте ещё раз</a>
      </p>

      <a href="{{ back }}" class="auth-submit btn-primary" style="display:flex;align-items:center;justify-content:center;text-decoration:none;">
        Вернуться к входу
      </a>

    {% else %}

      <!-- ══ ФОРМА ЗАПРОСА ══ -->
      <div class="auth-card-head">
        <div class="auth-logo-mark" style="background: var(--primary);">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" width="22" height="22"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h1 class="auth-title">Восстановление пароля</h1>
        <p class="auth-sub">Введите email, указанный при регистрации — мы пришлём ссылку для сброса пароля</p>
      </div>

      {% if error_warning %}
      <div class="auth-form-err">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>{{ error_warning }}</span>
      </div>
      {% endif %}

      <form action="{{ action }}" method="post">
        <div class="auth-field">
          <label class="auth-label" for="forgotEmail">Email</label>
          <input class="auth-input{% if error_warning %} is-err{% endif %}"
                 type="email" id="forgotEmail" name="email"
                 value="{{ email }}" placeholder="example@mail.ru"
                 autocomplete="email" autofocus>
        </div>

        <button type="submit" class="auth-submit btn-primary">Отправить ссылку</button>
      </form>

      <div class="auth-card-foot">
        <a class="auth-link" href="{{ back }}">← Вернуться к входу</a>
      </div>

    {% endif %}

  </div><!-- /auth-card -->

  <!-- ── ПРАВАЯ КОЛОНКА ── -->
  <div class="auth-aside">
    <h2 class="auth-aside-title">Как это работает?</h2>
    <p class="auth-aside-desc">Восстановите доступ к личному кабинету за несколько секунд</p>

    <ul class="auth-benefits">
      <li class="auth-benefit">
        <div class="auth-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div>
          <strong>Шаг 1 — укажите email</strong>
          <span>Введите адрес, который вы использовали при регистрации</span>
        </div>
      </li>
      <li class="auth-benefit">
        <div class="auth-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <div>
          <strong>Шаг 2 — письмо на email</strong>
          <span>Мы пришлём письмо со ссылкой для сброса пароля</span>
        </div>
      </li>
      <li class="auth-benefit">
        <div class="auth-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <div>
          <strong>Шаг 3 — новый пароль</strong>
          <span>Перейдите по ссылке и задайте новый пароль</span>
        </div>
      </li>
    </ul>

    <div class="auth-aside-note">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      Если письмо не пришло, проверьте папку «Спам»
    </div>
  </div>

</div><!-- /auth-layout -->

</div><!-- /wrap -->
</main>

{{ footer }}
