{{ header }}
<link rel="stylesheet" href="catalog/view/theme/evrika/stylesheet/account.css">

<main>
<div class="wrap">

  <!-- ХЛЕБНЫЕ КРОШКИ -->
  <nav class="breadcrumb" aria-label="Хлебные крошки">
    <a href="index.php?route=common/home">Главная</a>
    <span class="bc-sep">›</span>
    <a href="index.php?route=account/account">Личный кабинет</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">Мои данные</span>
  </nav>

  <div class="cab-layout">

    <!-- САЙДБАР -->
    <aside class="cab-sidebar">
      <div class="cab-user">
        <div class="cab-avatar">{{ firstname is defined ? firstname|first|upper : '' }}{{ lastname is defined ? lastname|first|upper : '' }}</div>
        <div class="cab-user-info">
          <div class="cab-user-name">{{ firstname is defined ? firstname : '' }} {{ lastname is defined ? lastname : '' }}</div>
          {% if customer_email is defined and customer_email %}<div class="cab-user-email">{{ customer_email }}</div>{% elseif email is defined and email %}<div class="cab-user-email">{{ email }}</div>{% endif %}
          <div class="cab-user-type">{{ customer_group is defined ? customer_group : '' }}</div>
        </div>
      </div>
      <nav class="cab-nav">
        <a class="cab-nav-link" href="index.php?route=account/account">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Обзор
        </a>
        <a class="cab-nav-link" href="index.php?route=account/order">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
          Мои заказы
        </a>
        <a class="cab-nav-link" href="index.php?route=account/wishlist">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          Избранное
        </a>
        <div class="cab-nav-divider"></div>
        <a class="cab-nav-link active" href="index.php?route=account/edit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Мои данные
        </a>
        <a class="cab-nav-link" href="index.php?route=account/address">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Адреса доставки
        </a>
        <div class="cab-nav-divider"></div>
        <a class="cab-nav-link cab-nav-link--danger" href="index.php?route=account/logout">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Выйти
        </a>
      </nav>
    </aside>

    <!-- ОСНОВНОЕ СОДЕРЖИМОЕ -->
    <div class="cab-main">
      <h1 class="cab-page-title">Мои данные</h1>

      {% if error_warning %}
      <div class="cab-success-banner" style="background:#fff0f0;border-color:#fca5a5;color:#dc2626">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        {{ error_warning }}
      </div>
      {% endif %}

      <form action="{{ action }}" method="post" enctype="multipart/form-data">

        <!-- ЛИЧНЫЕ ДАННЫЕ -->
        <div class="cab-form-section">
          <div class="cab-form-section-head">Личные данные</div>
          <div class="cab-form-body cols-2">
            <div class="cab-field{% if error_firstname %} has-error{% endif %}">
              <label for="inp-firstname">Имя <span style="color:#dc2626">*</span></label>
              <input type="text" id="inp-firstname" name="firstname" value="{{ firstname }}" placeholder="Введите имя">
              {% if error_firstname %}<div class="cab-field-error">{{ error_firstname }}</div>{% endif %}
            </div>
            <div class="cab-field{% if error_lastname %} has-error{% endif %}">
              <label for="inp-lastname">Фамилия <span style="color:#dc2626">*</span></label>
              <input type="text" id="inp-lastname" name="lastname" value="{{ lastname }}" placeholder="Введите фамилию">
              {% if error_lastname %}<div class="cab-field-error">{{ error_lastname }}</div>{% endif %}
            </div>
          </div>
          <div class="cab-form-footer">
            <span class="cab-form-footer-note">ФИО используется при оформлении заказов</span>
            <button type="submit" class="btn-primary" style="height:36px;font-size:13px">Сохранить</button>
          </div>
        </div>

        <!-- КОНТАКТНЫЕ ДАННЫЕ -->
        <div class="cab-form-section">
          <div class="cab-form-section-head">Контактные данные</div>
          <div class="cab-form-body cols-2">
            <div class="cab-field{% if error_email %} has-error{% endif %}">
              <label for="inp-email">Email <span style="color:#dc2626">*</span></label>
              <input type="email" id="inp-email" name="email" value="{{ email }}" placeholder="example@mail.ru">
              {% if error_email %}<div class="cab-field-error">{{ error_email }}</div>{% endif %}
            </div>
            <div class="cab-field{% if error_telephone %} has-error{% endif %}">
              <label for="inp-telephone">Телефон</label>
              <input type="tel" id="inp-telephone" name="telephone" value="{{ telephone }}" placeholder="+7 (___) ___-__-__">
              {% if error_telephone %}<div class="cab-field-error">{{ error_telephone }}</div>{% endif %}
            </div>
          </div>
          <div class="cab-form-footer">
            <span class="cab-form-footer-note">На email приходят подтверждения заказов</span>
            <button type="submit" class="btn-primary" style="height:36px;font-size:13px">Сохранить</button>
          </div>
        </div>

      </form>

      <!-- ИЗМЕНИТЬ ПАРОЛЬ -->
      <div class="cab-form-section">
        <div class="cab-form-section-head">Безопасность</div>
        <div style="padding:16px 20px 20px">
          <p style="font-size:13px;color:var(--ink-60);margin:0 0 14px">Для изменения пароля перейдите на отдельную страницу.</p>
          <a href="index.php?route=account/password" class="btn-outline" style="font-size:13px;display:inline-flex;align-items:center;gap:6px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Изменить пароль
          </a>
        </div>
      </div>

    </div><!-- /cab-main -->
  </div><!-- /cab-layout -->

</div><!-- /wrap -->
</main>

{{ footer }}
