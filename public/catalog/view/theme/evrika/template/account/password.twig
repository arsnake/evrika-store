{{ header }}
<link rel="stylesheet" href="catalog/view/theme/evrika/stylesheet/account.css">

<main>
<div class="wrap">

  <!-- ХЛЕБНЫЕ КРОШКИ -->
  <nav class="breadcrumb" aria-label="Хлебные крошки">
    <a href="index.php?route=common/home">Главная</a>
    <span class="bc-sep">›</span>
    <a href="index.php?route=account/account">Личный кабинет</a>
    <span class="bc-sep">›</span>
    <a href="index.php?route=account/edit">Мои данные</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">Изменить пароль</span>
  </nav>

  <div class="cab-layout">

    <!-- САЙДБАР -->
    <aside class="cab-sidebar">
      <div class="cab-user">
        <div class="cab-avatar">{{ firstname is defined ? firstname|first|upper : '' }}{{ lastname is defined ? lastname|first|upper : '' }}</div>
        <div class="cab-user-info">
          <div class="cab-user-name">{{ firstname is defined ? firstname : '' }} {{ lastname is defined ? lastname : '' }}</div>
          {% if customer_email is defined and customer_email %}<div class="cab-user-email">{{ customer_email }}</div>{% endif %}
          <div class="cab-user-type">{{ customer_group is defined ? customer_group : '' }}</div>
        </div>
      </div>
      <nav class="cab-nav">
        <a class="cab-nav-link" href="index.php?route=account/account">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Обзор
        </a>
        <a class="cab-nav-link" href="index.php?route=account/order">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
          Мои заказы
        </a>
        <a class="cab-nav-link" href="index.php?route=account/wishlist">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          Избранное
        </a>
        <div class="cab-nav-divider"></div>
        <a class="cab-nav-link active" href="index.php?route=account/edit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Мои данные
        </a>
        <a class="cab-nav-link" href="index.php?route=account/address">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Адреса доставки
        </a>
        <div class="cab-nav-divider"></div>
        <a class="cab-nav-link cab-nav-link--danger" href="index.php?route=account/logout">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Выйти
        </a>
      </nav>
    </aside>

    <!-- ОСНОВНОЕ СОДЕРЖИМОЕ -->
    <div class="cab-main">
      <h1 class="cab-page-title">Изменить пароль</h1>

      <form action="{{ action }}" method="post" enctype="multipart/form-data">
        <div class="cab-form-section">
          <div class="cab-form-section-head">Новый пароль</div>
          <div class="cab-form-body" style="grid-template-columns:1fr;max-width:480px">

            <div class="cab-field{% if error_password %} has-error{% endif %}">
              <label for="inp-pwd-new">Новый пароль <span style="color:#dc2626">*</span></label>
              <input type="password" id="inp-pwd-new" name="password" value="{{ password }}" placeholder="Минимум 4 символа" autocomplete="new-password">
              {% if error_password %}<div class="cab-field-error">{{ error_password }}</div>{% endif %}
            </div>

            <div class="cab-field{% if error_confirm %} has-error{% endif %}">
              <label for="inp-pwd-confirm">Повторите пароль <span style="color:#dc2626">*</span></label>
              <input type="password" id="inp-pwd-confirm" name="confirm" value="{{ confirm }}" placeholder="Повторите новый пароль" autocomplete="new-password">
              {% if error_confirm %}<div class="cab-field-error">{{ error_confirm }}</div>{% endif %}
            </div>

            <p style="font-size:12px;color:var(--ink-40);margin:0">
              Пароль должен содержать от 4 до 40 символов.
            </p>

          </div>
          <div class="cab-form-footer">
            <a href="{{ back }}" class="btn-outline" style="font-size:13px">← Назад</a>
            <button type="submit" class="btn-primary" style="height:36px;font-size:13px">Сохранить пароль</button>
          </div>
        </div>
      </form>

    </div><!-- /cab-main -->
  </div><!-- /cab-layout -->

</div><!-- /wrap -->
</main>

{{ footer }}
