{{ header }}
<link rel="stylesheet" href="catalog/view/theme/evrika/stylesheet/auth.css">

<main>
<div class="wrap">

<nav class="breadcrumb" aria-label="Хлебные крошки">
  {% for breadcrumb in breadcrumbs %}
    {% if loop.first %}
      <a href="{{ breadcrumb.href }}">Главная</a>
    {% else %}
      <span class="bc-sep">›</span>
      {% if loop.last %}
        <span class="bc-current">{{ breadcrumb.text }}</span>
      {% else %}
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      {% endif %}
    {% endif %}
  {% endfor %}
</nav>

<div class="auth-layout">

  <!-- ── ФОРМА ── -->
  <div class="auth-card">

    <!-- Вкладки: Войти / Регистрация -->
    <div class="auth-page-tabs" id="authPageTabs">
      <button type="button" class="auth-ptab auth-ptab--active" id="tabLogin" data-panel="panelLogin">Войти</button>
      <button type="button" class="auth-ptab" id="tabRegister" data-panel="panelRegister">Регистрация</button>
    </div>

    <!-- ══ ПАНЕЛЬ ВХОДА ══ -->
    <div id="panelLogin">

      <div class="auth-card-head">
        <div class="auth-logo-mark">
          <svg viewBox="0 0 44 44" fill="none"><text x="22" y="32" font-size="28" font-weight="700" text-anchor="middle" fill="#fff" font-family="Georgia,serif">Э</text></svg>
        </div>
        <h1 class="auth-title">Вход в личный кабинет</h1>
        <p class="auth-sub">Введите email и пароль для входа</p>
      </div>

      {% if error_warning %}
      <div class="auth-form-err">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>{{ error_warning }}</span>
      </div>
      {% endif %}

      {% if success %}
      <div class="auth-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        <span>{{ success }}</span>
      </div>
      {% endif %}

      <form action="{{ action }}" method="post">
        <input type="hidden" name="redirect" value="{{ redirect }}">

        <div class="auth-field">
          <label class="auth-label" for="loginEmail">Email</label>
          <input class="auth-input" type="email" id="loginEmail" name="email"
                 value="{{ email }}" placeholder="example@mail.ru" autocomplete="username">
        </div>

        <div class="auth-field">
          <div class="auth-label-row">
            <label class="auth-label" for="loginPassword">Пароль</label>
            <a class="auth-link" href="{{ forgotten }}" style="font-size:11px;">Забыли пароль?</a>
          </div>
          <div class="auth-input-wrap">
            <input class="auth-input" type="password" id="loginPassword" name="password"
                   value="{{ password }}" placeholder="Введите пароль" autocomplete="current-password">
            <button type="button" class="auth-eye" data-eye="loginPassword" aria-label="Показать пароль">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <button type="submit" class="auth-submit btn-primary">Войти</button>
      </form>

      <div class="auth-card-foot">
        Нет аккаунта?
        <a class="auth-link" href="#" id="goRegister">Зарегистрироваться</a>
      </div>
    </div>

    <!-- ══ ПАНЕЛЬ РЕГИСТРАЦИИ ══ -->
    <div id="panelRegister" class="auth-panel--hidden">

      <div class="auth-card-head">
        <div class="auth-logo-mark">
          <svg viewBox="0 0 44 44" fill="none"><text x="22" y="32" font-size="28" font-weight="700" text-anchor="middle" fill="#fff" font-family="Georgia,serif">Э</text></svg>
        </div>
        <h1 class="auth-title">Создать аккаунт</h1>
        <p class="auth-sub">Зарегистрируйтесь, чтобы получить доступ к личному кабинету и специальным ценам</p>
      </div>

      <form action="{{ register }}" method="post">

        <fieldset class="reg-section">
          <legend class="reg-section-title">Личные данные</legend>
          <div class="reg-grid">
            <div class="auth-field">
              <label class="auth-label" for="regLastName">Фамилия <span class="req">*</span></label>
              <input class="auth-input" type="text" id="regLastName" name="lastname"
                     placeholder="Иванов" autocomplete="family-name">
            </div>
            <div class="auth-field">
              <label class="auth-label" for="regFirstName">Имя <span class="req">*</span></label>
              <input class="auth-input" type="text" id="regFirstName" name="firstname"
                     placeholder="Иван" autocomplete="given-name">
            </div>
          </div>
        </fieldset>

        <fieldset class="reg-section">
          <legend class="reg-section-title">Контактные данные</legend>
          <div class="reg-grid">
            <div class="auth-field">
              <label class="auth-label" for="regEmail">Email <span class="req">*</span></label>
              <input class="auth-input" type="email" id="regEmail" name="email"
                     placeholder="example@mail.ru" autocomplete="email">
            </div>
            <div class="auth-field">
              <label class="auth-label" for="regPhone">Телефон <span class="req">*</span></label>
              <input class="auth-input" type="tel" id="regPhone" name="telephone"
                     placeholder="+7 (___) ___-__-__" autocomplete="tel">
            </div>
          </div>
        </fieldset>

        <fieldset class="reg-section">
          <legend class="reg-section-title">Пароль</legend>
          <div class="reg-grid">
            <div class="auth-field">
              <label class="auth-label" for="regPassword">Пароль <span class="req">*</span></label>
              <div class="auth-input-wrap">
                <input class="auth-input" type="password" id="regPassword" name="password"
                       placeholder="Минимум 8 символов" autocomplete="new-password">
                <button type="button" class="auth-eye" data-eye="regPassword" aria-label="Показать пароль">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
            </div>
            <div class="auth-field">
              <label class="auth-label" for="regConfirm">Подтвердите пароль <span class="req">*</span></label>
              <div class="auth-input-wrap">
                <input class="auth-input" type="password" id="regConfirm" name="confirm"
                       placeholder="Повторите пароль" autocomplete="new-password">
                <button type="button" class="auth-eye" data-eye="regConfirm" aria-label="Показать пароль">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
            </div>
          </div>
        </fieldset>

        <div class="reg-agree">

          {# Согласие на обработку ПД — обязательно (152-ФЗ ст.9) #}
          <div class="consent-row consent-row--required">
            <input type="checkbox" id="regAgreePD" name="agree" value="1"
                   class="consent-checkbox" required aria-required="true">
            <label class="consent-label" for="regAgreePD">
              Даю согласие на обработку
              <a href="{{ base }}pd-consent" target="_blank" rel="noopener">персональных данных</a>
              <span class="consent-required-mark">*</span>
            </label>
          </div>

          {# Пользовательское соглашение — обязательно #}
          <div class="consent-row consent-row--required">
            <input type="checkbox" id="regAgreeTerms" name="agree_terms" value="1"
                   class="consent-checkbox" required aria-required="true">
            <label class="consent-label" for="regAgreeTerms">
              Принимаю условия
              <a href="{{ base }}terms" target="_blank" rel="noopener">Пользовательского соглашения</a>
              <span class="consent-required-mark">*</span>
            </label>
          </div>

          {# Рекламная рассылка — добровольно (38-ФЗ ст.18) #}
          <div class="consent-row">
            <input type="checkbox" id="regNewsletter" name="newsletter" value="1"
                   class="consent-checkbox">
            <label class="consent-label" for="regNewsletter">
              Согласен получать
              <a href="{{ base }}newsletter-consent" target="_blank" rel="noopener">рекламные рассылки</a>
              об акциях и новых поступлениях (необязательно)
            </label>
          </div>

        </div>

        <div class="reg-actions">
          <button type="submit" class="auth-submit btn-primary">Создать аккаунт</button>
        </div>
      </form>

      <div class="auth-card-foot">
        Уже есть аккаунт?
        <a class="auth-link" href="#" id="goLogin">Войти</a>
      </div>
    </div>

  </div><!-- /auth-card -->

  <!-- ── ПРАВАЯ КОЛОНКА ── -->
  <div class="auth-aside">
    <h2 class="auth-aside-title" id="asideTitle">Личный кабинет Эврики</h2>
    <p class="auth-aside-desc" id="asideDesc">Управляйте заказами, следите за статусом доставки и получайте персональные предложения</p>

    <ul class="auth-benefits">
      <li class="auth-benefit">
        <div class="auth-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        </div>
        <div>
          <strong>История заказов</strong>
          <span>Все ваши заказы и документы в одном месте</span>
        </div>
      </li>
      <li class="auth-benefit">
        <div class="auth-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </div>
        <div>
          <strong>Список избранного</strong>
          <span>Сохраняйте товары и возвращайтесь к ним</span>
        </div>
      </li>
      <li class="auth-benefit">
        <div class="auth-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <div>
          <strong>Быстрое оформление</strong>
          <span>Сохранённые адреса и данные для оплаты</span>
        </div>
      </li>
      <li class="auth-benefit">
        <div class="auth-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
        </div>
        <div>
          <strong>Персональные скидки</strong>
          <span>Специальные цены и акции для постоянных клиентов</span>
        </div>
      </li>
    </ul>

    <div class="auth-aside-note">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      Данные защищены и не передаются третьим лицам
    </div>
  </div>

</div><!-- /auth-layout -->

</div><!-- /wrap -->
</main>

<script>
(function () {
  var tabLogin    = document.getElementById('tabLogin');
  var tabRegister = document.getElementById('tabRegister');
  var panelLogin  = document.getElementById('panelLogin');
  var panelReg    = document.getElementById('panelRegister');
  var asideTitle  = document.getElementById('asideTitle');
  var asideDesc   = document.getElementById('asideDesc');
  var goReg       = document.getElementById('goRegister');
  var goLogin     = document.getElementById('goLogin');

  var ASIDE = {
    login:    { title: 'Личный кабинет Эврики',      desc: 'Управляйте заказами, следите за статусом доставки и получайте персональные предложения' },
    register: { title: 'Зачем регистрироваться?',    desc: 'Получите доступ к личному кабинету, специальным ценам и удобному управлению заказами' }
  };

  function switchTo(tab) {
    var isReg = (tab === 'register');
    tabLogin.classList.toggle('auth-ptab--active', !isReg);
    tabRegister.classList.toggle('auth-ptab--active', isReg);
    panelLogin.classList.toggle('auth-panel--hidden', isReg);
    panelReg.classList.toggle('auth-panel--hidden', !isReg);
    asideTitle.textContent = isReg ? ASIDE.register.title : ASIDE.login.title;
    asideDesc.textContent  = isReg ? ASIDE.register.desc  : ASIDE.login.desc;
    history.replaceState(null, '', isReg ? '#register' : '#login');
  }

  tabLogin.addEventListener('click',    function () { switchTo('login'); });
  tabRegister.addEventListener('click', function () { switchTo('register'); });
  goReg.addEventListener('click',   function (e) { e.preventDefault(); switchTo('register'); });
  goLogin.addEventListener('click', function (e) { e.preventDefault(); switchTo('login'); });

  /* Eye-toggle for all password fields */
  document.querySelectorAll('.auth-eye[data-eye]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var inp = document.getElementById(btn.dataset.eye);
      if (inp) inp.type = (inp.type === 'password') ? 'text' : 'password';
    });
  });

  /* Auto-open register tab if URL has #register */
  if (window.location.hash === '#register') switchTo('register');
})();
</script>

{{ footer }}
