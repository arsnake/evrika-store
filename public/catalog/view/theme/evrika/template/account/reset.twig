{{ header }}
<link rel="stylesheet" href="catalog/view/theme/evrika/stylesheet/auth.css">

<main>
<div class="wrap">

<nav class="breadcrumb" aria-label="Хлебные крошки">
  {% for breadcrumb in breadcrumbs %}
    {% if loop.first %}
      <a href="{{ breadcrumb.href }}">Главная</a>
    {% else %}
      <span class="bc-sep">›</span>
      {% if loop.last %}
        <span class="bc-current">{{ breadcrumb.text }}</span>
      {% else %}
        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      {% endif %}
    {% endif %}
  {% endfor %}
</nav>

<div class="auth-layout">

  <!-- ── ФОРМА ── -->
  <div class="auth-card">

    <div class="auth-card-head">
      <div class="auth-logo-mark" style="background: var(--primary);">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" width="22" height="22"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <h1 class="auth-title">Новый пароль</h1>
      <p class="auth-sub">Придумайте надёжный пароль для вашего аккаунта</p>
    </div>

    {% if error_password or error_confirm %}
    <div class="auth-form-err">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>{% if error_password %}{{ error_password }}{% else %}{{ error_confirm }}{% endif %}</span>
    </div>
    {% endif %}

    <form action="{{ action }}" method="post">

      <div class="auth-field">
        <label class="auth-label" for="resetPassword">Новый пароль</label>
        <div class="auth-input-wrap">
          <input class="auth-input{% if error_password %} is-err{% endif %}"
                 type="password" id="resetPassword" name="password"
                 value="{{ password }}" placeholder="Минимум 4 символа"
                 autocomplete="new-password" autofocus>
          <button type="button" class="auth-eye" data-eye="resetPassword" aria-label="Показать пароль">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        {% if error_password %}
        <span class="auth-field-err">{{ error_password }}</span>
        {% endif %}
      </div>

      <div class="auth-field">
        <label class="auth-label" for="resetConfirm">Подтвердите пароль</label>
        <div class="auth-input-wrap">
          <input class="auth-input{% if error_confirm %} is-err{% endif %}"
                 type="password" id="resetConfirm" name="confirm"
                 value="{{ confirm }}" placeholder="Повторите пароль"
                 autocomplete="new-password">
          <button type="button" class="auth-eye" data-eye="resetConfirm" aria-label="Показать пароль">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        {% if error_confirm %}
        <span class="auth-field-err">{{ error_confirm }}</span>
        {% endif %}
      </div>

      <button type="submit" class="auth-submit btn-primary">Сохранить пароль</button>
    </form>

    <div class="auth-card-foot">
      <a class="auth-link" href="{{ back }}">← Вернуться к входу</a>
    </div>

  </div><!-- /auth-card -->

  <!-- ── ПРАВАЯ КОЛОНКА ── -->
  <div class="auth-aside">
    <h2 class="auth-aside-title">Надёжный пароль</h2>
    <p class="auth-aside-desc">Несколько советов, чтобы ваш аккаунт оставался защищённым</p>

    <ul class="auth-benefits">
      <li class="auth-benefit">
        <div class="auth-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        </div>
        <div>
          <strong>Минимум 8 символов</strong>
          <span>Чем длиннее пароль — тем сложнее его подобрать</span>
        </div>
      </li>
      <li class="auth-benefit">
        <div class="auth-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
        </div>
        <div>
          <strong>Буквы, цифры и символы</strong>
          <span>Используйте разные типы символов: A–Z, 0–9, !@#$</span>
        </div>
      </li>
      <li class="auth-benefit">
        <div class="auth-benefit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div>
          <strong>Не используйте очевидное</strong>
          <span>Избегайте дат рождения, имён и простых слов</span>
        </div>
      </li>
    </ul>

    <div class="auth-aside-note">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      Данные защищены и не передаются третьим лицам
    </div>
  </div>

</div><!-- /auth-layout -->

</div><!-- /wrap -->
</main>

<script>
document.querySelectorAll('.auth-eye[data-eye]').forEach(function (btn) {
  btn.addEventListener('click', function () {
    var inp = document.getElementById(btn.dataset.eye);
    if (inp) inp.type = (inp.type === 'password') ? 'text' : 'password';
  });
});
</script>

{{ footer }}
