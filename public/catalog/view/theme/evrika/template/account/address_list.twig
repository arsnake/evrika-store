{{ header }}
<link rel="stylesheet" href="catalog/view/theme/evrika/stylesheet/account.css">

<main>
<div class="wrap">

  <!-- ХЛЕБНЫЕ КРОШКИ -->
  <nav class="breadcrumb" aria-label="Хлебные крошки">
    <a href="index.php?route=common/home">Главная</a>
    <span class="bc-sep">›</span>
    <a href="index.php?route=account/account">Личный кабинет</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">Адреса доставки</span>
  </nav>

  <div class="cab-layout">

    <!-- САЙДБАР -->
    <aside class="cab-sidebar">
      <div class="cab-user">
        <div class="cab-avatar">{{ firstname is defined ? firstname|first|upper : '' }}{{ lastname is defined ? lastname|first|upper : '' }}</div>
        <div class="cab-user-info">
          <div class="cab-user-name">{{ firstname is defined ? firstname : '' }} {{ lastname is defined ? lastname : '' }}</div>
          {% if customer_email is defined and customer_email %}<div class="cab-user-email">{{ customer_email }}</div>{% endif %}
          <div class="cab-user-type">{{ customer_group is defined ? customer_group : '' }}</div>
        </div>
      </div>
      <nav class="cab-nav">
        <a class="cab-nav-link" href="index.php?route=account/account">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Обзор
        </a>
        <a class="cab-nav-link" href="index.php?route=account/order">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
          Мои заказы
        </a>
        <a class="cab-nav-link" href="index.php?route=account/wishlist">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          Избранное
        </a>
        <div class="cab-nav-divider"></div>
        <a class="cab-nav-link" href="index.php?route=account/edit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Мои данные
        </a>
        <a class="cab-nav-link active" href="index.php?route=account/address">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Адреса доставки
        </a>
        <div class="cab-nav-divider"></div>
        <a class="cab-nav-link cab-nav-link--danger" href="index.php?route=account/logout">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Выйти
        </a>
      </nav>
    </aside>

    <!-- ОСНОВНОЕ СОДЕРЖИМОЕ -->
    <div class="cab-main">

      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
        <h1 class="cab-page-title" style="margin:0">Адреса доставки</h1>
        <a href="{{ add }}" class="btn-primary" style="font-size:13px;display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 16px;text-decoration:none">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Добавить адрес
        </a>
      </div>

      {% if error_warning %}
      <div class="cab-success-banner" style="background:#fff0f0;border-color:#fca5a5;color:#dc2626;margin-bottom:16px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        {{ error_warning }}
      </div>
      {% endif %}

      {% if success %}
      <div class="cab-success-banner" style="margin-bottom:16px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {{ success }}
      </div>
      {% endif %}

      {% if addresses %}

      <div class="addr-grid">
        {% for address in addresses %}
        <div class="addr-card">
          <div class="addr-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="addr-card-body">
            <div class="addr-card-text">{{ address.address|raw }}</div>
          </div>
          <div class="addr-card-actions">
            <a href="{{ address.update }}" class="btn-outline" style="font-size:12px;height:30px;padding:0 12px;display:inline-flex;align-items:center;gap:5px">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              Изменить
            </a>
            <a href="{{ address.delete }}" class="btn-outline" style="font-size:12px;height:30px;padding:0 12px;display:inline-flex;align-items:center;gap:5px;color:var(--ink-40);border-color:var(--ink-10)" onclick="return confirm('Удалить этот адрес?')">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
              Удалить
            </a>
          </div>
        </div>
        {% endfor %}
      </div>

      {% else %}

      <div class="cab-empty">
        <div class="cab-empty-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <div class="cab-empty-title">Адресов пока нет</div>
        <div class="cab-empty-text">Добавьте адрес доставки, чтобы ускорить оформление заказов</div>
        <a href="{{ add }}" class="btn-primary">Добавить адрес</a>
      </div>

      {% endif %}

    </div><!-- /cab-main -->
  </div><!-- /cab-layout -->

</div><!-- /wrap -->
</main>

{{ footer }}
