{{ header }}
<link rel="stylesheet" href="catalog/view/theme/evrika/stylesheet/account.css">

<main>
<div class="wrap">

  <!-- ХЛЕБНЫЕ КРОШКИ -->
  <nav class="breadcrumb" aria-label="Хлебные крошки">
    <a href="index.php?route=common/home">Главная</a>
    <span class="bc-sep">›</span>
    <a href="index.php?route=account/account">Личный кабинет</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">Избранное</span>
  </nav>

  <div class="cab-layout">

    <!-- САЙДБАР -->
    <aside class="cab-sidebar">
      <div class="cab-user">
        <div class="cab-avatar">{{ firstname is defined ? firstname|first|upper : '' }}{{ lastname is defined ? lastname|first|upper : '' }}</div>
        <div class="cab-user-info">
          <div class="cab-user-name">{{ firstname is defined ? firstname : '' }} {{ lastname is defined ? lastname : '' }}</div>
          {% if customer_email is defined and customer_email %}<div class="cab-user-email">{{ customer_email }}</div>{% endif %}
          <div class="cab-user-type">{{ customer_group is defined ? customer_group : '' }}</div>
        </div>
      </div>
      <nav class="cab-nav">
        <a class="cab-nav-link" href="index.php?route=account/account">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Обзор
        </a>
        <a class="cab-nav-link" href="index.php?route=account/order">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
          Мои заказы
        </a>
        <a class="cab-nav-link active" href="index.php?route=account/wishlist">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          Избранное
        </a>
        <div class="cab-nav-divider"></div>
        <a class="cab-nav-link" href="index.php?route=account/edit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Мои данные
        </a>
        <a class="cab-nav-link" href="index.php?route=account/address">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Адреса доставки
        </a>
        <div class="cab-nav-divider"></div>
        <a class="cab-nav-link cab-nav-link--danger" href="index.php?route=account/logout">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Выйти
        </a>
      </nav>
    </aside>

    <!-- ОСНОВНОЕ СОДЕРЖИМОЕ -->
    <div class="cab-main">

      {% if success %}
      <div class="cab-success-banner">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {{ success }}
      </div>
      {% endif %}

      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
        <h1 class="cab-page-title" style="margin:0">Избранное{% if products %} <span style="font-size:16px;color:var(--ink-40);font-weight:400">({{ products|length }})</span>{% endif %}</h1>
      </div>

      {% if products %}

      <div class="products-row-4">
        {% for product in products %}
        <div class="prod-card" data-pid="{{ product.product_id }}">

          <a href="{{ product.href }}" class="prod-img" aria-label="{{ product.name }}">
            {% if product.thumb %}
              <img src="{{ product.thumb }}" alt="{{ product.name }}" loading="lazy">
            {% else %}
              <svg viewBox="0 0 80 80" fill="none"><rect x="15" y="8" width="50" height="64" rx="6" fill="#EBF5EF"/><path d="M25 20h30M25 30h20" stroke="#9ABFAA" stroke-width="3" stroke-linecap="round"/></svg>
            {% endif %}
          </a>

          <div class="prod-info">
            {% if product.model %}
              <div class="prod-sku">Код: <span>{{ product.model }}</span></div>
            {% endif %}

            {% if product.manufacturer is defined and product.manufacturer %}
              <div class="prod-brand">{{ product.manufacturer }}</div>
            {% endif %}

            <a href="{{ product.href }}" class="prod-name">{{ product.name }}</a>

            {% if product.price %}
              <div class="prod-price-block">
                {% if product.special %}
                  <span class="prod-price-old">{{ product.price }}</span>
                  <div class="prod-price-row">
                    <span class="prod-price">{{ product.special }}</span>
                    <span class="prod-price-unit">/ шт.</span>
                  </div>
                {% else %}
                  <div class="prod-price-row">
                    <span class="prod-price">{{ product.price }}</span>
                    <span class="prod-price-unit">/ шт.</span>
                  </div>
                {% endif %}
              </div>

              <div class="prod-stock in-stock">
                <svg viewBox="0 0 8 8" width="7" height="7" fill="currentColor" aria-hidden="true"><circle cx="4" cy="4" r="4"/></svg>
                {{ product.stock }}
              </div>

              <div class="prod-actions">
                <div class="prod-qty-ctrl">
                  <button class="prod-qty-btn minus" aria-label="Уменьшить" type="button">−</button>
                  <input class="prod-qty-input" type="number" value="{{ product.minimum is defined ? product.minimum : 1 }}" min="{{ product.minimum is defined ? product.minimum : 1 }}" aria-label="Количество">
                  <button class="prod-qty-btn plus" aria-label="Увеличить" type="button">+</button>
                </div>
                <a href="{{ product.remove }}" class="prod-fav-btn active" title="Убрать из избранного" aria-label="Убрать из избранного">
                  <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </a>
                <button class="prod-cart-btn" aria-label="В корзину" title="В корзину" type="button"
                  data-pid="{{ product.product_id }}"
                  data-href="{{ product.href }}"
                  data-has-opts="{{ product.has_required_options is defined and product.has_required_options ? '1' : '0' }}"
                  onclick="cardCartAdd(this, false)">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                </button>
                <button class="prod-quick-btn" aria-label="Купить сейчас" title="Купить сейчас" type="button"
                  data-pid="{{ product.product_id }}"
                  data-href="{{ product.href }}"
                  data-has-opts="{{ product.has_required_options is defined and product.has_required_options ? '1' : '0' }}"
                  onclick="cardCartAdd(this, true)">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                </button>
              </div>

            {% else %}
              <div class="prod-auth">
                Чтобы увидеть цены —
                <a href="index.php?route=account/login">авторизуйтесь</a>
              </div>
            {% endif %}
          </div>

        </div>
        {% endfor %}
      </div>

      {% else %}

      <div class="cab-empty">
        <div class="cab-empty-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </div>
        <div class="cab-empty-title">Избранное пусто</div>
        <div class="cab-empty-text">Добавляйте товары в избранное, чтобы не потерять их</div>
        <a href="index.php?route=product/category" class="btn-primary">Перейти в каталог</a>
      </div>

      {% endif %}

    </div><!-- /cab-main -->
  </div><!-- /cab-layout -->

</div><!-- /wrap -->
</main>

{{ footer }}
