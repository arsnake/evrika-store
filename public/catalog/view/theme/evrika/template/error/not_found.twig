{{ header }}

<main>
<div class="wrap">

  <nav class="breadcrumb" aria-label="Хлебные крошки">
    {% for breadcrumb in breadcrumbs %}
    {% if loop.first %}
    <a href="{{ breadcrumb.href }}">Главная</a>
    {% if not loop.last %}<span class="bc-sep">›</span>{% endif %}
    {% elseif not loop.last %}
    <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
    <span class="bc-sep">›</span>
    {% else %}
    <span class="bc-current">{{ breadcrumb.text }}</span>
    {% endif %}
    {% endfor %}
  </nav>

  <div class="nf-wrap">

    <div class="nf-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17" stroke-width="2" stroke-linecap="round"/></svg>
    </div>

    <div class="nf-code">404</div>
    <h1 class="nf-title">{{ heading_title }}</h1>
    <p class="nf-text">Страница, которую вы ищете, не существует или была перемещена.<br>Воспользуйтесь поиском или вернитесь на главную.</p>

    <div class="nf-actions">
      <a href="{{ continue }}" class="btn-primary" style="display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 24px;text-decoration:none;font-size:14px">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 21V12h6v9"/></svg>
        На главную
      </a>
      <a href="index.php?route=product/search" class="btn-outline" style="display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 24px;text-decoration:none;font-size:14px">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
        Поиск по каталогу
      </a>
    </div>

  </div>

</div>
</main>

<style>
.nf-wrap {
  text-align: center;
  padding: 60px 24px 80px;
  max-width: 480px;
  margin: 0 auto;
}

.nf-icon {
  width: 80px; height: 80px;
  background: var(--surface-2);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 20px;
  color: var(--ink-30);
}
.nf-icon svg { width: 40px; height: 40px; }

.nf-code {
  font-family: var(--font-display);
  font-size: 72px; font-weight: 700; line-height: 1;
  color: var(--ink-10);
  margin-bottom: 4px;
  letter-spacing: -2px;
}

.nf-title {
  font-family: var(--font-display);
  font-size: 20px; font-weight: 700;
  color: var(--ink);
  margin: 0 0 12px;
}

.nf-text {
  font-size: 14px; color: var(--ink-50);
  line-height: 1.6;
  margin: 0 0 32px;
}

.nf-actions {
  display: flex; align-items: center; justify-content: center;
  gap: 12px; flex-wrap: wrap;
}

@media (max-width: 640px) {
  .nf-wrap { padding: 40px 16px 60px; }
  .nf-code { font-size: 56px; }
  .nf-title { font-size: 17px; }
  .nf-actions { flex-direction: column; }
  .nf-actions a { width: 100%; justify-content: center; }
}
</style>

{{ footer }}
