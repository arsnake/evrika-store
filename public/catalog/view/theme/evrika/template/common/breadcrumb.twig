{% if breadcrumbs %}
<nav class="breadcrumb" aria-label="Хлебные крошки">
  {% for breadcrumb in breadcrumbs %}
    {% if not loop.last %}
      <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
      <span class="bc-sep" aria-hidden="true">›</span>
    {% else %}
      <span class="bc-current" aria-current="page">{{ breadcrumb.text }}</span>
    {% endif %}
  {% endfor %}
</nav>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{% for breadcrumb in breadcrumbs %}{% if loop.index > 1 %},{% endif %}
    { "@type": "ListItem", "position": {{ loop.index }}, "name": "{{ breadcrumb.text | e('js') }}", "item": "{{ breadcrumb.href }}" }{% endfor %}
  ]
}
</script>
{% endif %}
