{{ header }}

<main id="page-home">
<div class="wrap">

  <!-- PROMO BANNER -->
  <div class="promo-section">
    <div class="promo-grid">
        <!-- СЛАЙДЕР НОВЫХ ПОСТУПЛЕНИЙ (модуль: Design → Layouts → Home → Content Top → Slideshow) -->
      {{ content_top }}


      <div class="promo-side">
        <div class="promo-card orange">
          <div>
            <div class="promo-card-title">{{ promo1_title is defined ? promo1_title : 'Открой своё дело' }}</div>
            <div class="promo-card-sub">{{ promo1_desc is defined ? promo1_desc : 'Франшиза КанцПарк — от 1 млн ₽' }}</div>
          </div>
          {% if promo1_icon_svg is defined and promo1_icon_svg %}
          <div class="promo-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">{{ promo1_icon_svg|raw }}</svg>
          </div>
          {% endif %}
        </div>
        <div class="promo-card dark">
          <div>
            <div class="promo-card-title">{{ promo2_title is defined ? promo2_title : 'Коллекция 2026' }}</div>
            <div class="promo-card-sub">{{ promo2_desc is defined ? promo2_desc : 'Школьный текстиль — уже в продаже' }}</div>
          </div>
          {% if promo2_icon_svg is defined and promo2_icon_svg %}
          <div class="promo-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">{{ promo2_icon_svg|raw }}</svg>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- CHIPS -->
  <div class="chips-row">
    <div class="chip hot">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2c0 6-6 8-6 14a6 6 0 0 0 12 0c0-6-6-8-6-14z"/></svg>
      Хиты недели
    </div>
    <div class="chip active">Новинки 2026</div>
    <div class="chip">Berlingo</div>
    <div class="chip">ГАММА</div>
    <div class="chip">Brauberg</div>
    <div class="chip">СТАММ</div>
    <div class="chip">Красин</div>
    <div class="chip">OfficeSpace</div>
    <div class="chip">Реестр МПТ</div>
    <div class="chip">Честный знак</div>
  </div>

  <!-- ПОПУЛЯРНЫЕ РАЗДЕЛЫ (модуль: Design → Layouts → Home → Content Bottom → Category) -->
  {{ content_bottom }}

  <!-- USP -->
  <div class="section">
    <div class="usp-section">
      <div class="usp-grid">
        <div class="usp-item">
          <div class="usp-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="usp-text">
            <h4>Оригинальные товары</h4>
            <p>Работаем напрямую с производителями. Гарантия подлинности каждого артикула</p>
          </div>
        </div>
        <div class="usp-item">
          <div class="usp-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="usp-text">
            <h4>99% заказов в срок</h4>
            <p>Собственный склад 15 000 м² и отлаженная логистика по всей России</p>
          </div>
        </div>
        <div class="usp-item">
          <div class="usp-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="usp-text">
            <h4>1000+ точек выдачи</h4>
            <p>Склады и пункты выдачи в 85 регионах России. Доставка от 1 дня</p>
          </div>
        </div>
        <div class="usp-b2b">
          <h3>Покупайте как юрлицо</h3>
          <ul class="usp-b2b-list">
            <li>Оптовая система скидок</li>
            <li>Возврат НДС</li>
            <li>Отсрочка платежа</li>
            <li>Персональный менеджер</li>
            <li>Личный кабинет</li>
            <li>ЭДО</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- BRANDS -->
  <div class="section" id="section-brands">
    <div class="section-head">
      <h2 class="section-title">Бренды</h2>
    </div>
    <div class="brands-row">
      <div class="brand-chip"><span>Berlingo</span></div>
      <div class="brand-chip"><span>ГАММА</span></div>
      <div class="brand-chip"><span>Brauberg</span></div>
      <div class="brand-chip"><span>СТАММ</span></div>
      <div class="brand-chip"><span>Красин</span></div>
      <div class="brand-chip"><span>Munhwa</span></div>
      <div class="brand-chip"><span>Crown</span></div>
      <div class="brand-chip"><span>OfficeSpace</span></div>
      <div class="brand-chip"><span>ArtSpace</span></div>
      <div class="brand-chip"><span>Илим</span></div>
      <div class="brand-chip"><span>Attache</span></div>
      <div class="brand-chip"><span>ErichKrause</span></div>
    </div>
  </div>

  <!-- NEWS -->
  <div class="section" id="section-news">
    <div class="section-head">
      <h2 class="section-title">Новости</h2>
      <a class="section-more" href="#">
        Все новости
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
    <div class="news-grid">
      <div class="news-card">
        <div class="news-thumb" style="background:linear-gradient(135deg,#2D7A4F20,#D4621A10)">
          <svg viewBox="0 0 60 60" fill="none"><rect x="10" y="15" width="40" height="30" rx="4" fill="#2D7A4F" opacity=".15"/><path d="M20 25h20M20 32h14" stroke="#2D7A4F" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <div class="news-body">
          <div class="news-date">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            18 мая 2026 г.
          </div>
          <div class="news-title">Grout Marker от MunHwa: быстрое обновление плиточных швов</div>
          <div class="news-excerpt">Бренд MunHwa продолжает расширять линейку — маркер-краска Grout Marker вызовет интерес у покупателей как в профессиональной среде, так и в быту.</div>
        </div>
      </div>
      <div class="news-card">
        <div class="news-thumb" style="background:linear-gradient(135deg,#D4621A10,#E8873A15)">
          <svg viewBox="0 0 60 60" fill="none"><circle cx="30" cy="30" r="18" fill="#D4621A" opacity=".1"/><path d="M22 30l6 6 10-12" stroke="#D4621A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="news-body">
          <div class="news-date">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            15 мая 2026 г.
          </div>
          <div class="news-title">«Сезон ярких идей» — чековая акция для КанцПарк</div>
          <div class="news-excerpt">С 15 мая по 30 июня 2026 года в сети магазинов КанцПарк стартует акция для роста продаж и привлечения новой аудитории.</div>
        </div>
      </div>
      <div class="news-card">
        <div class="news-thumb" style="background:linear-gradient(135deg,#2D7A4F10,#1A6B8A10)">
          <svg viewBox="0 0 60 60" fill="none"><path d="M15 45L30 15l15 30H15z" fill="#2D7A4F" opacity=".1"/><path d="M23 35h14" stroke="#2D7A4F" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <div class="news-body">
          <div class="news-date">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            8 мая 2026 г.
          </div>
          <div class="news-title">«Транзит плюс»: больше баллов ДЖЭМ за транзитные отгрузки</div>
          <div class="news-excerpt">С 20 апреля по 31 мая клиенты получают дополнительные баллы программы лояльности ДЖЭМ за транзитные отгрузки бумаги «ИЛИМ».</div>
        </div>
      </div>
      <div class="news-card">
        <div class="news-thumb" style="background:linear-gradient(135deg,#2D7A4F15,#1A2E1E10)">
          <svg viewBox="0 0 60 60" fill="none"><rect x="12" y="20" width="36" height="20" rx="3" fill="#2D7A4F" opacity=".12"/><path d="M20 28h20M20 34h12" stroke="#2D7A4F" stroke-width="1.5" stroke-linecap="round"/></svg>
        </div>
        <div class="news-body">
          <div class="news-date">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            7 мая 2026 г.
          </div>
          <div class="news-title">Скидки месяца — ещё больше выгодных товаров в одном разделе</div>
          <div class="news-excerpt">Раздел «Скидки месяца» обновился: добавили новые категории, увеличили количество товаров и добавили спецпредложения для партнёров.</div>
        </div>
      </div>
    </div>
  </div>

</div>
</main>

{{ footer }}
