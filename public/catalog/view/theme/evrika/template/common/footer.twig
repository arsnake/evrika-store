{# ── ПОДВАЛ ── #}
<footer>
  <div class="wrap">
    <div class="footer-grid">

      <div class="footer-brand">
        <div class="footer-logo">
          <div class="footer-logo-mark">
            <svg viewBox="0 0 38 38" fill="none"><text x="19" y="28" font-size="24" font-weight="700" text-anchor="middle" fill="#fff" font-family="Georgia,serif">Э</text></svg>
          </div>
          <div class="footer-logo-text">{{ store_name is defined ? store_name : 'Эврика' }}</div>
        </div>
        <div class="footer-desc">Товары оптом для офиса, школы и творчества</div>
        {% if telephone is defined and telephone %}
        <div class="footer-phones">
          <a href="tel:{{ telephone|replace({' ':''}) }}">{{ telephone }}</a>
        </div>
        {% endif %}
        {% if address is defined and address %}
        <div class="footer-addr">{{ address|raw }}</div>
        {% endif %}
        {% if open is defined and open %}
        <div class="footer-open">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" d="M12 6v6l4 2"/></svg>
          {{ open|raw }}
        </div>
        {% endif %}
      </div>

      <div class="footer-col">
        <h4>Каталоги</h4>
        <a href="#">Каталог товаров</a>
        <a href="#">Хит продаж</a>
        <a href="#">Новинки</a>
      </div>

      <div class="footer-col">
        <h4>О компании</h4>
        <a href="{{ base }}about_us">О компании</a>
        <a href="{{ base }}about_us">Реквизиты</a>
      </div>

      <div class="footer-col">
        <h4>Новым клиентам</h4>
        <a href="#">Почему мы</a>
        <a href="{{ base }}index.php?route=account/register">Зарегистрироваться</a>
        <a href="{{ base }}delivery">Доставка и оплата</a>
        <a href="{{ base }}return-rules">Правила возврата</a>
      </div>

      <div class="footer-col">
        <h4>Документы</h4>
        <a href="{{ base }}privacy">Политика конфиденциальности</a>
        <a href="{{ base }}terms">Пользовательское соглашение</a>
        <a href="{{ base }}oferta">Публичная оферта</a>
        <a href="{{ base }}return-rules">Правила возврата и обмена</a>
        <a href="{{ base }}index.php?route=information/sitemap">Карта сайта</a>
      </div>

    </div>

    <div class="footer-bottom">
      <p>© {{ year is defined ? year : '2026' }} {{ store_name is defined ? store_name : 'Эврика' }}. Все права защищены. ИП Иванов И.И., ИНН 612301234567</p>
      <div class="footer-social">
        <a class="social-btn" href="https://t.me/+bGC49k-VtxIzM2Ri" target="_blank" rel="noopener" aria-label="Telegram-канал Эврика" style="background:#2CA5E0;">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        </a>
        <a class="social-btn" href="https://t.me/+YC8Dr6Ah-J9mMDBi" target="_blank" rel="noopener" aria-label="Telegram-чат Эврика" style="background:#1A73C9;">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        </a>
        <a class="social-btn" href="mailto:manager@evrikamlt.ru" aria-label="Написать на email" style="background:#34A853;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M2 7l10 7 10-7"/></svg>
        </a>
      </div>
    </div>

  </div>
</footer>

{# Кнопка «Наверх» #}
<button class="scroll-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" type="button" aria-label="Наверх">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/></svg>
</button>

{# ── Cookie-баннер ── #}
<div id="cookie-banner" role="region" aria-label="Уведомление об использовании файлов cookie" style="display:none;">
  <span class="cookie-icon" aria-hidden="true">🍪</span>
  <div class="cookie-text">
    Мы используем файлы cookie для корректной работы сайта и аналитики.
    Продолжая использование сайта, вы соглашаетесь с
    <a href="{{ base }}privacy" target="_blank" rel="noopener">Политикой конфиденциальности</a>.
  </div>
  <div class="cookie-actions">
    <button id="cookie-accept-all" class="cookie-btn cookie-btn--accept" type="button">Принять все</button>
    <button id="cookie-accept-essential" class="cookie-btn cookie-btn--essential" type="button">Только необходимые</button>
  </div>
</div>

</div>{# /site-content #}

{# Скрипты подвала (из document->getScripts('footer')) #}
{% for style in styles %}
<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}">
{% endfor %}
{% for script in scripts %}
<script src="{{ script }}" type="text/javascript"></script>
{% endfor %}

{# Глобальные методы корзины — должны быть до main.js #}
<script src="catalog/view/theme/evrika/js/cart.js" type="text/javascript"></script>

{# Основной JS темы #}
<script src="catalog/view/theme/evrika/js/main.js" type="text/javascript"></script>

{# Cookie consent #}
<script src="catalog/view/theme/evrika/js/cookie.js" type="text/javascript"></script>

</body>
</html>
