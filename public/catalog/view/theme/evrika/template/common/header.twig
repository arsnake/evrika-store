{# ── МОБИЛЬНЫЙ ПОИСК — fullscreen overlay ── #}
<div class="mob-search-overlay" id="mobSearch" aria-hidden="true">
  <div class="mob-search-panel">

    <div class="mob-search-top">
      <div class="mob-search-hdr">
        <span class="mob-search-title">Поиск по каталогу</span>
        <button class="mob-search-close-btn" onclick="toggleMobSearch()" type="button" aria-label="Закрыть">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <form action="index.php" method="get" onsubmit="return mobSearchSubmit(this)">
        <input type="hidden" name="route" value="product/search">
        <div class="mob-search-field">
          <span class="mob-search-field-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
          </span>
          <input type="text" name="search" id="mobSearchInput" placeholder="Название, артикул, производитель..." autocomplete="off" aria-label="Поиск">
          <button type="submit" class="mob-search-submit" aria-label="Найти">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>
      </form>
    </div>

    <div class="mob-search-results" id="mobSearchResults">
      <div class="lsr-hint">Введите от 3 символов для поиска</div>
    </div>

  </div>
</div>

{# ── МОБИЛЬНАЯ НИЖНЯЯ НАВИГАЦИЯ ── #}
<nav class="mob-nav" aria-label="Мобильная навигация">
  <button class="mob-nav-item active" onclick="openCatalog()" type="button">
