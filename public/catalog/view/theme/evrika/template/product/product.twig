{{ header }}

<main id="page-product">
<div class="wrap">

  {# ── Хлебные крошки ── #}
  <nav class="breadcrumb" aria-label="Хлебные крошки">
    <a href="index.php?route=common/home">Главная</a>
    <span class="bc-sep" aria-hidden="true">›</span>
    <a href="index.php?route=product/category">Каталог</a>
    {% if breadcrumbs %}
      {% for breadcrumb in breadcrumbs %}
        {% if loop.index > 1 %}
          <span class="bc-sep" aria-hidden="true">›</span>
          {% if loop.last %}
            <span class="bc-current" aria-current="page">{{ breadcrumb.text }}</span>
          {% else %}
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}
  </nav>

  {# ═══════════════════════════════════════
     PRODUCT SECTION — всегда 3 колонки
     галерея | инфо+опции | панель покупки
     ═══════════════════════════════════════ #}
  <section class="product-section">

    {# ── КОЛОНКА 1: ГАЛЕРЕЯ ── #}
    <div class="gallery-wrap">

      <div class="gallery-main" id="galleryMain"
           role="button"
           aria-label="Увеличить изображение"
           tabindex="0">
        {% if thumb %}
          <img src="{{ thumb }}" alt="{{ heading_title }}" id="mainImage" fetchpriority="high" decoding="async">
        {% else %}
          <div class="gallery-main-placeholder">
            <svg viewBox="0 0 80 80" fill="none" aria-hidden="true">
              <rect x="15" y="8" width="50" height="64" rx="6" fill="#EBF5EF"/>
              <path d="M25 20h30M25 30h20" stroke="#9ABFAA" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </div>
        {% endif %}
      </div>

      {% if images %}
        <div class="gallery-thumbs" role="list" aria-label="Дополнительные изображения">
          {% if thumb %}
            <button class="gallery-thumb active" role="listitem"
                    aria-label="{{ heading_title }}"
                    data-img="{{ popup ? popup : thumb }}"
                    data-thumb="{{ thumb }}"
                    type="button">
              <img src="{{ thumb }}" alt="{{ heading_title }}" loading="lazy" width="80" height="80">
            </button>
          {% endif %}
          {% for image in images %}
            <button class="gallery-thumb" role="listitem"
                    aria-label="{{ heading_title }} — фото {{ loop.index + 1 }}"
                    data-img="{{ image.popup }}"
                    data-thumb="{{ image.thumb }}"
                    type="button">
              <img src="{{ image.thumb }}" alt="{{ heading_title }}" loading="lazy" width="80" height="80">
            </button>
          {% endfor %}
        </div>
      {% endif %}

    </div>{# /gallery-wrap #}


    {# ── КОЛОНКА 2: ИНФОРМАЦИЯ ── #}
    <div class="product-info">

      <h1 class="product-title">{{ heading_title }}</h1>

      {# META STRIP: наличие · код · бренд #}
      <div class="product-meta-strip">
        {% if stock %}
          <span class="availability-in">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            {{ stock }}
          </span>
        {% endif %}
        {% if model %}
          {% if stock %}<span class="meta-sep" aria-hidden="true">·</span>{% endif %}
          <span class="meta-sku">Код: <span class="sku-value" title="Нажмите, чтобы скопировать">{{ model }}</span></span>
        {% endif %}
        {% if manufacturer %}
          <span class="meta-sep" aria-hidden="true">·</span>
          <span class="meta-brand">Бренд: <a href="{{ manufacturers }}">{{ manufacturer }}</a></span>
        {% endif %}
      </div>

      {# KEY SPECS — первые 3 атрибута + ссылка #}
      {% if attribute_groups %}
        <div class="key-specs">
          {% for attribute_group in attribute_groups %}
            {% if loop.first %}
              {% for attribute in attribute_group.attribute %}
                {% if loop.index <= 3 %}
                  <span class="key-spec-pill">
                    <span class="ksp-name">{{ attribute.name }}</span>
                    <span class="ksp-val">{{ attribute.text | raw }}</span>
                  </span>
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endfor %}
          <button class="key-specs-link" type="button" onclick="switchTab('specs')">Все характеристики →</button>
        </div>
      {% endif %}

      {# ОПЦИИ (только в 3-колоночном режиме) #}
      {% if options %}
        <div class="product-options">
          {% for option in options %}
            <div class="product-option" id="product-option-{{ option.product_option_id }}">
              <div class="option-label">
                {{ option.name }}{% if option.required %} <span class="option-required">*</span>{% endif %}
              </div>

              {% if option.type == 'select' %}
                <select class="option-select" name="option[{{ option.product_option_id }}]"{% if option.required %} required{% endif %}>
                  <option value="">--- выберите ---</option>
                  {% for option_value in option.product_option_value %}
                    <option value="{{ option_value.product_option_value_id }}"{% if option_value.price %} data-price="{{ option_value.price_prefix }}{{ option_value.price }}"{% endif %}>
                      {{ option_value.name }}{% if option_value.price %} ({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}
                    </option>
                  {% endfor %}
                </select>

              {% elseif option.type == 'radio' %}
                <div class="option-radio-group">
                  {% for option_value in option.product_option_value %}
                    <label class="option-radio-label">
                      <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ option_value.product_option_value_id }}"{% if option_value.price %} data-price="{{ option_value.price_prefix }}{{ option_value.price }}"{% endif %}{% if option.required %} required{% endif %}>
                      {{ option_value.name }}{% if option_value.price %} ({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}
                    </label>
                  {% endfor %}
                </div>

              {% elseif option.type == 'checkbox' %}
                <div class="option-checkbox-group">
                  {% for option_value in option.product_option_value %}
                    <label class="option-check-label">
                      <input type="checkbox" name="option[{{ option.product_option_id }}][]" value="{{ option_value.product_option_value_id }}"{% if option_value.price %} data-price="{{ option_value.price_prefix }}{{ option_value.price }}"{% endif %}>
                      {{ option_value.name }}{% if option_value.price %} ({{ option_value.price_prefix }}{{ option_value.price }}){% endif %}
                    </label>
                  {% endfor %}
                </div>

              {% elseif option.type == 'text' %}
                <input type="text" class="option-text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}"{% if option.required %} required{% endif %}>

              {% elseif option.type == 'textarea' %}
                <textarea class="option-textarea" name="option[{{ option.product_option_id }}]"{% if option.required %} required{% endif %}>{{ option.value }}</textarea>

              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

    </div>{# /product-info #}


    {# ══════════════════════════════════════════
       КОЛОНКА 3: ПАНЕЛЬ ПОКУПКИ
       ══════════════════════════════════════════ #}
    <aside class="product-buy-panel">

        <div class="buy-price">
          {% if special %}
            <div class="buy-price-row">
              <span class="price-value">{{ special }}</span>
              <span class="price-unit">/ шт.</span>
            </div>
            <div class="price-old-row">
              <span class="price-old">{{ price }}</span>
            </div>
          {% elseif price %}
            <div class="buy-price-row">
              <span class="price-value">{{ price }}</span>
              <span class="price-unit">/ шт.</span>
            </div>
          {% endif %}
        </div>

        {% if discounts %}
          <div class="buy-discounts">
            <div class="buy-discounts-label">Оптовые цены</div>
            {% for discount in discounts %}
              <div class="price-discount-row">
                <span>от {{ discount.quantity }} шт.</span>
                <span class="price-discount-val">{{ discount.price }}</span>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {# Количество + «В корзину» иконкой #}
        <div class="buy-qty-row">
          <div class="qty-control" aria-label="Количество">
            <button class="qty-btn minus" type="button" aria-label="Уменьшить количество">−</button>
            <input class="qty-input" type="number" id="input-quantity" name="quantity"
                   value="{{ minimum }}" min="{{ minimum }}" aria-label="Количество">
            <button class="qty-btn plus" type="button" aria-label="Увеличить количество">+</button>
          </div>
          <button class="btn-cart btn-cart--icon" type="button" id="button-cart"
                  aria-label="В корзину"
                  title="В корзину"
                  onclick="cartAdd('{{ product_id }}', document.getElementById('input-quantity').value, collectOptions(document.querySelector('.product-section')), this)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </button>
        </div>

        <button class="btn-quick-order btn-quick-order--full" type="button" id="button-quick-order-panel"
                onclick="cartAdd('{{ product_id }}', document.getElementById('input-quantity').value, collectOptions(document.querySelector('.product-section')), null, true)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
          Купить сейчас
        </button>

        <div class="buy-secondary-actions">
          <button class="buy-action-link" type="button" onclick="wishlist.add('{{ product_id }}')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            В избранное
          </button>
          <button class="buy-action-link" type="button" onclick="compare.add('{{ product_id }}')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
            Сравнить
          </button>
        </div>

    </aside>{# /product-buy-panel #}

  </section>


  {# ═══════════════════════════════════════
     ВКЛАДКИ
     ═══════════════════════════════════════ #}
  <div class="product-tabs-wrap">

    <div class="tabs-nav" role="tablist">
      <button class="tab-btn active" data-tab="desc" role="tab" aria-selected="true" aria-controls="tab-desc" type="button">
        Описание
      </button>
      {% if attribute_groups %}
        <button class="tab-btn" data-tab="specs" role="tab" aria-selected="false" aria-controls="tab-specs" type="button">
          Характеристики
        </button>
      {% endif %}
      {% if review_status %}
        <button class="tab-btn" data-tab="reviews" role="tab" aria-selected="false" aria-controls="tab-reviews" type="button">
          {{ tab_review }}
        </button>
      {% endif %}
    </div>

    <div class="tab-panel active" id="tab-desc" role="tabpanel">
      <h2 class="visually-hidden">Описание товара</h2>
      {% if description %}
        {{ description | raw }}
      {% else %}
        <p style="color:var(--ink-60)">Описание отсутствует.</p>
      {% endif %}
      {% if tags %}
        <div class="product-tags">
          {% for tag in tags %}
            <a class="product-tag" href="{{ tag.href }}">{{ tag.tag }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if attribute_groups %}
      <div class="tab-panel" id="tab-specs" role="tabpanel">
        <h2 class="visually-hidden">Характеристики товара</h2>
        {% for attribute_group in attribute_groups %}
          <h3>{{ attribute_group.name }}</h3>
          <table class="specs-full-table">
            <tbody>
              {% for attribute in attribute_group.attribute %}
                <tr>
                  <td>{{ attribute.name }}</td>
                  <td>{{ attribute.text | raw }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% endfor %}
      </div>
    {% endif %}

    {% if review_status %}
      <div class="tab-panel" id="tab-reviews" role="tabpanel">
        <h2 class="visually-hidden">Отзывы о товаре</h2>
        <div id="review-list"></div>

        <div class="reviews-empty" id="reviews-empty-state">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <circle cx="32" cy="32" r="28" fill="var(--ink-10)"/>
            <path d="M20 26h24M20 32h18M20 38h12" stroke="var(--ink-30)" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
          <h3>Отзывов пока нет</h3>
          <p>Будьте первым, кто оставит отзыв об этом товаре.</p>
        </div>

        <form class="review-form" id="form-review" onsubmit="return false;">
          <h3>Оставить отзыв</h3>
          <div>
            <label for="review-name">Ваше имя</label>
            <input type="text" id="review-name" name="name" value="{{ customer_name }}" placeholder="Ваше имя" autocomplete="name">
          </div>
          <div>
            <label>Оценка</label>
            <div class="rating-stars" role="group" aria-label="Оценка от 1 до 5 звёзд">
              <button type="button" class="star-btn" aria-label="1 звезда">★</button>
              <button type="button" class="star-btn" aria-label="2 звезды">★</button>
              <button type="button" class="star-btn" aria-label="3 звезды">★</button>
              <button type="button" class="star-btn" aria-label="4 звезды">★</button>
              <button type="button" class="star-btn" aria-label="5 звёзд">★</button>
            </div>
          </div>
          <div>
            <label for="review-text">Текст отзыва</label>
            <textarea id="review-text" name="text" placeholder="Расскажите о своём опыте использования товара..."></textarea>
          </div>
          <button type="button" class="btn-submit" onclick="review.save()">Отправить отзыв</button>
        </form>

      </div>
    {% endif %}

  </div>{# /product-tabs-wrap #}


  {# ═══════════════════════════════════════
     ПОХОЖИЕ ТОВАРЫ
     ═══════════════════════════════════════ #}
  {% if products %}
    <section class="related-section" aria-label="Похожие товары">
      <div class="section-head">
        <h2 class="section-title">Похожие товары</h2>
      </div>
      <div class="related-slider-wrap">

        <button class="slider-prev" type="button" aria-label="Назад">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>

        <div class="related-slider" role="list">
          {% for product in products %}
            <div class="prod-card" role="listitem" data-pid="{{ product.product_id }}">

              <a href="{{ product.href }}" class="prod-img" aria-label="{{ product.name }}">
                {% if product.thumb %}
                  <img src="{{ product.thumb }}" alt="{{ product.name }}" loading="lazy">
                {% else %}
                  <svg viewBox="0 0 80 80" fill="none"><rect x="15" y="8" width="50" height="64" rx="6" fill="#EBF5EF"/><path d="M25 20h30M25 30h20" stroke="#9ABFAA" stroke-width="3" stroke-linecap="round"/></svg>
                {% endif %}
              </a>

              <div class="prod-info">
                {% if product.model %}<div class="prod-sku">Код: <span>{{ product.model }}</span></div>{% endif %}
                {% if product.manufacturer %}<div class="prod-brand">{{ product.manufacturer }}</div>{% endif %}
                <a href="{{ product.href }}" class="prod-name">{{ product.name }}</a>

                {% if product.price %}
                  <div class="prod-price-block">
                    {% if product.special %}
                      <span class="prod-price-old">{{ product.price }}</span>
                      <div class="prod-price-row">
                        <span class="prod-price">{{ product.special }}</span>
                        <span class="prod-price-unit">/ шт.</span>
                      </div>
                    {% else %}
                      <div class="prod-price-row">
                        <span class="prod-price">{{ product.price }}</span>
                        <span class="prod-price-unit">/ шт.</span>
                      </div>
                    {% endif %}
                  </div>
                  <div class="prod-stock {% if product.stock %}in-stock{% else %}out-stock{% endif %}">
                    <svg viewBox="0 0 8 8" width="7" height="7" fill="currentColor" aria-hidden="true"><circle cx="4" cy="4" r="4"/></svg>
                    {% if product.stock %}В наличии{% else %}Нет в наличии{% endif %}
                  </div>
                  <div class="prod-actions">
                    <div class="prod-qty-ctrl">
                      <button class="prod-qty-btn minus" aria-label="Уменьшить" type="button">−</button>
                      <input class="prod-qty-input" type="number" value="{{ product.minimum|default(1) }}" min="{{ product.minimum|default(1) }}" aria-label="Количество">
                      <button class="prod-qty-btn plus" aria-label="Увеличить" type="button">+</button>
                    </div>
                    <button class="prod-fav-btn" aria-label="В избранное" title="В избранное" type="button"
                      onclick="wishlist.add('{{ product.product_id }}')">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    </button>
                    <button class="prod-cart-btn" aria-label="В корзину" title="В корзину" type="button"
                      data-pid="{{ product.product_id }}"
                      data-href="{{ product.href }}"
                      data-has-opts="{{ product.has_required_options ? '1' : '0' }}"
                      onclick="cardCartAdd(this, false)">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    </button>
                    <button class="prod-quick-btn" aria-label="Купить сейчас" title="Купить сейчас" type="button"
                      data-pid="{{ product.product_id }}"
                      data-href="{{ product.href }}"
                      data-has-opts="{{ product.has_required_options ? '1' : '0' }}"
                      onclick="cardCartAdd(this, true)">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                    </button>
                  </div>
                {% else %}
                  <div class="prod-auth">
                    Чтобы увидеть цены —
                    <a href="index.php?route=account/login">авторизуйтесь</a>
                    или
                    <a href="index.php?route=account/register">зарегистрируйтесь</a>
                  </div>
                {% endif %}
              </div>

            </div>
          {% endfor %}
        </div>

        <button class="slider-next" type="button" aria-label="Вперёд">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </button>

      </div>
    </section>
  {% endif %}

</div>{# /wrap #}
</main>

{# ── LIGHTBOX ── #}
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Просмотр изображения">
  <button class="lightbox-close" type="button" aria-label="Закрыть">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>
  <button class="lightbox-prev" type="button" aria-label="Предыдущее">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="22" height="22" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
    </svg>
  </button>
  <div class="lightbox-svg-wrap" id="lightboxContent"></div>
  <button class="lightbox-next" type="button" aria-label="Следующее">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="22" height="22" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
    </svg>
  </button>
</div>

<script src="catalog/view/theme/evrika/js/product.js" type="text/javascript"></script>

{# ── МОБИЛЬНАЯ ПАНЕЛЬ ПОКУПКИ — видна только на мобиле, прикреплена над mob-nav ── #}
<div class="mob-buy-bar" id="mob-buy-bar" aria-label="Быстрая покупка">
  <div class="mob-buy-price">
    {% if special %}
      <span class="price-value">{{ special }}</span>
      <span class="mob-price-old">{{ price }}</span>
    {% elseif price %}
      <span class="price-value">{{ price }}</span>
    {% endif %}
    <span class="price-unit">/ шт.</span>
  </div>
  <div class="qty-control" aria-label="Количество">
    <button class="qty-btn minus" type="button" aria-label="Уменьшить количество">−</button>
    <input class="qty-input" type="number" id="input-quantity-mob"
           value="{{ minimum }}" min="{{ minimum }}" aria-label="Количество">
    <button class="qty-btn plus" type="button" aria-label="Увеличить количество">+</button>
  </div>
  <button class="btn-cart mob-btn-cart" type="button"
          onclick="cartAdd('{{ product_id }}', document.getElementById('input-quantity-mob').value, collectOptions(document.querySelector('.product-section')), this)"
          aria-label="В корзину">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
      <line x1="3" y1="6" x2="21" y2="6"/>
      <path d="M16 10a4 4 0 0 1-8 0"/>
    </svg>
    В корзину
  </button>
  <button class="btn-icon-action mob-btn-quick" type="button"
          id="button-quick-order-mob"
          aria-label="Купить сейчас" title="Купить сейчас"
          onclick="cartAdd('{{ product_id }}', document.getElementById('input-quantity-mob').value, collectOptions(document.querySelector('.product-section')), null, true)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
    </svg>
  </button>
</div>

{% if product_url %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ heading_title | e('js') }}"{% if thumb %},
  "image": "{{ thumb }}"{% endif %}{% if model %},
  "sku": "{{ model | e('js') }}"{% endif %}{% if manufacturer %},
  "brand": { "@type": "Brand", "name": "{{ manufacturer | e('js') }}" }{% endif %}{% if description %},
  "description": "{{ description | striptags | slice(0, 500) | e('js') }}"{% endif %},
  "url": "{{ product_url }}",
  "offers": {
    "@type": "Offer",
    "priceCurrency": "{{ currency_code | e('js') }}",
    "price": "{{ price_raw }}",
    "availability": "https://schema.org/{% if stock %}InStock{% else %}OutOfStock{% endif %}",
    "url": "{{ product_url }}"
  }
}
</script>
{% endif %}
{{ footer }}
