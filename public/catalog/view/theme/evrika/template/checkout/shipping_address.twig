{% if addresses %}
<div style="margin-bottom:14px;">
  <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:var(--ink);margin-bottom:8px;">
    <input type="radio" name="shipping_address" value="existing" checked="checked" style="accent-color:var(--primary);" />
    Использовать сохранённый адрес
  </label>
  <div id="shipping-existing" style="margin-left:24px;margin-bottom:10px;">
    <div class="co-form-group">
      <select name="address_id" id="input-shipping-address-id">
        {% for address in addresses %}
        {% if address.address_id == address_id %}
        <option value="{{ address.address_id }}" selected="selected">{{ address.firstname }} {{ address.lastname }}, {{ address.address_1 }}, {{ address.city }}, {{ address.zone }}, {{ address.country }}</option>
        {% else %}
        <option value="{{ address.address_id }}">{{ address.firstname }} {{ address.lastname }}, {{ address.address_1 }}, {{ address.city }}, {{ address.zone }}, {{ address.country }}</option>
        {% endif %}
        {% endfor %}
      </select>
    </div>
  </div>

  <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:var(--ink);">
    <input type="radio" name="shipping_address" value="new" style="accent-color:var(--primary);" />
    Добавить новый адрес
  </label>
</div>
{% endif %}

<div id="shipping-new" style="display:{% if addresses %}none{% else %}block{% endif %};">

  <div class="co-form-grid co-form-grid--2">
    <div class="co-form-group" id="fg-shipping-firstname">
      <label for="input-shipping-firstname">Имя <span class="co-req">*</span></label>
      <input type="text" name="firstname" value="" placeholder="Имя" id="input-shipping-firstname" autocomplete="given-name" />
    </div>
    <div class="co-form-group" id="fg-shipping-lastname">
      <label for="input-shipping-lastname">Фамилия <span class="co-req">*</span></label>
      <input type="text" name="lastname" value="" placeholder="Фамилия" id="input-shipping-lastname" autocomplete="family-name" />
    </div>
  </div>

  <div class="co-form-group" id="fg-shipping-company">
    <label for="input-shipping-company">Компания / Организация</label>
    <input type="text" name="company" value="" placeholder="Название организации" id="input-shipping-company" autocomplete="organization" />
  </div>

  <div class="co-form-group" id="fg-shipping-address-1">
    <label for="input-shipping-address-1">Адрес, строка 1 <span class="co-req">*</span></label>
    <input type="text" name="address_1" value="" placeholder="Улица, дом, квартира" id="input-shipping-address-1" autocomplete="address-line1" />
  </div>

  <div class="co-form-group" id="fg-shipping-address-2">
    <label for="input-shipping-address-2">Адрес, строка 2</label>
    <input type="text" name="address_2" value="" placeholder="Дополнение к адресу" id="input-shipping-address-2" autocomplete="address-line2" />
  </div>

  <div class="co-form-grid co-form-grid--3">
    <div class="co-form-group" id="fg-shipping-city">
      <label for="input-shipping-city">Город <span class="co-req">*</span></label>
      <input type="text" name="city" value="" placeholder="Город" id="input-shipping-city" autocomplete="address-level2" />
    </div>
    <div class="co-form-group" id="fg-shipping-postcode">
      <label for="input-shipping-postcode">Индекс <span class="co-req">*</span></label>
      <input type="text" name="postcode" value="{{ postcode }}" placeholder="000000" id="input-shipping-postcode" autocomplete="postal-code" />
    </div>
    <div class="co-form-group" id="fg-shipping-country">
      <label for="input-shipping-country">Страна <span class="co-req">*</span></label>
      <select name="country_id" id="input-shipping-country">
        <option value="">— Выберите —</option>
        {% for country in countries %}
        {% if country.country_id == country_id %}
        <option value="{{ country.country_id }}" selected="selected">{{ country.name }}</option>
        {% else %}
        <option value="{{ country.country_id }}">{{ country.name }}</option>
        {% endif %}
        {% endfor %}
      </select>
    </div>
  </div>

  <div class="co-form-group" id="fg-shipping-zone">
    <label for="input-shipping-zone">Область / Регион <span class="co-req">*</span></label>
    <select name="zone_id" id="input-shipping-zone">
    </select>
  </div>

  {% for custom_field in custom_fields %}
  {% if custom_field.type == 'select' %}
  <div class="co-form-group{% if custom_field.required %} co-form-required{% endif %} custom-field" data-sort="{{ custom_field.sort_order }}">
    <label for="input-shipping-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }}{% if custom_field.required %} <span class="co-req">*</span>{% endif %}</label>
    <select name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" id="input-shipping-custom-field{{ custom_field.custom_field_id }}">
      <option value="">— Выберите —</option>
      {% for custom_field_value in custom_field.custom_field_value %}
      <option value="{{ custom_field_value.custom_field_value_id }}">{{ custom_field_value.name }}</option>
      {% endfor %}
    </select>
  </div>
  {% endif %}
  {% if custom_field.type == 'radio' %}
  <div class="co-form-group{% if custom_field.required %} co-form-required{% endif %} custom-field" data-sort="{{ custom_field.sort_order }}">
    <label>{{ custom_field.name }}{% if custom_field.required %} <span class="co-req">*</span>{% endif %}</label>
    <div id="input-shipping-custom-field{{ custom_field.custom_field_id }}">
      {% for custom_field_value in custom_field.custom_field_value %}
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;margin-bottom:5px;">
        <input type="radio" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{{ custom_field_value.custom_field_value_id }}" style="accent-color:var(--primary);" />
        {{ custom_field_value.name }}
      </label>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  {% if custom_field.type == 'checkbox' %}
  <div class="co-form-group{% if custom_field.required %} co-form-required{% endif %} custom-field" data-sort="{{ custom_field.sort_order }}">
    <label>{{ custom_field.name }}{% if custom_field.required %} <span class="co-req">*</span>{% endif %}</label>
    <div id="input-shipping-custom-field{{ custom_field.custom_field_id }}">
      {% for custom_field_value in custom_field.custom_field_value %}
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;margin-bottom:5px;">
        <input type="checkbox" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}][]" value="{{ custom_field_value.custom_field_value_id }}" style="accent-color:var(--primary);" />
        {{ custom_field_value.name }}
      </label>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  {% if custom_field.type == 'text' %}
  <div class="co-form-group{% if custom_field.required %} co-form-required{% endif %} custom-field" data-sort="{{ custom_field.sort_order }}">
    <label for="input-shipping-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }}{% if custom_field.required %} <span class="co-req">*</span>{% endif %}</label>
    <input type="text" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{{ custom_field.value }}" placeholder="{{ custom_field.name }}" id="input-shipping-custom-field{{ custom_field.custom_field_id }}" />
  </div>
  {% endif %}
  {% if custom_field.type == 'textarea' %}
  <div class="co-form-group{% if custom_field.required %} co-form-required{% endif %} custom-field" data-sort="{{ custom_field.sort_order }}">
    <label for="input-shipping-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }}{% if custom_field.required %} <span class="co-req">*</span>{% endif %}</label>
    <textarea name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" rows="4" placeholder="{{ custom_field.name }}" id="input-shipping-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.value }}</textarea>
  </div>
  {% endif %}
  {% if custom_field.type == 'file' %}
  <div class="co-form-group{% if custom_field.required %} co-form-required{% endif %} custom-field" data-sort="{{ custom_field.sort_order }}">
    <label>{{ custom_field.name }}{% if custom_field.required %} <span class="co-req">*</span>{% endif %}</label>
    <div style="display:flex;align-items:center;gap:10px;">
      <button type="button" id="button-shipping-custom-field{{ custom_field.custom_field_id }}" class="btn btn-primary" style="font-size:12px;padding:8px 14px;">Загрузить файл</button>
      <input type="hidden" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="" id="input-shipping-custom-field{{ custom_field.custom_field_id }}" />
    </div>
  </div>
  {% endif %}
  {% if custom_field.type == 'date' %}
  <div class="co-form-group{% if custom_field.required %} co-form-required{% endif %} custom-field" data-sort="{{ custom_field.sort_order }}">
    <label for="input-shipping-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }}{% if custom_field.required %} <span class="co-req">*</span>{% endif %}</label>
    <div class="input-group date">
      <input type="text" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{{ custom_field.value }}" placeholder="ГГГГ-ММ-ДД" data-date-format="YYYY-MM-DD" id="input-shipping-custom-field{{ custom_field.custom_field_id }}" />
    </div>
  </div>
  {% endif %}
  {% if custom_field.type == 'time' %}
  <div class="co-form-group{% if custom_field.required %} co-form-required{% endif %} custom-field" data-sort="{{ custom_field.sort_order }}">
    <label for="input-shipping-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }}{% if custom_field.required %} <span class="co-req">*</span>{% endif %}</label>
    <div class="input-group time">
      <input type="text" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{{ custom_field.value }}" placeholder="ЧЧ:ММ" data-date-format="HH:mm" id="input-shipping-custom-field{{ custom_field.custom_field_id }}" />
    </div>
  </div>
  {% endif %}
  {% if custom_field.type == 'datetime' %}
  <div class="co-form-group{% if custom_field.required %} co-form-required{% endif %} custom-field" data-sort="{{ custom_field.sort_order }}">
    <label for="input-shipping-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }}{% if custom_field.required %} <span class="co-req">*</span>{% endif %}</label>
    <div class="input-group datetime">
      <input type="text" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{{ custom_field.value }}" placeholder="ГГГГ-ММ-ДД ЧЧ:ММ" data-date-format="YYYY-MM-DD HH:mm" id="input-shipping-custom-field{{ custom_field.custom_field_id }}" />
    </div>
  </div>
  {% endif %}
  {% endfor %}

</div>{# /#shipping-new #}

<div class="co-step-actions">
  <button type="button" id="button-shipping-address" class="btn btn-primary">
    Продолжить
  </button>
</div>

<script type="text/javascript">
// existing/new toggle
$('input[name="shipping_address"]').on('change', function() {
    if (this.value === 'new') {
        $('#shipping-existing').hide();
        $('#shipping-new').show();
    } else {
        $('#shipping-existing').show();
        $('#shipping-new').hide();
    }
});

// Sort custom fields
$('#collapse-shipping-address .co-form-group[data-sort]').detach().each(function() {
    var sort = parseInt($(this).attr('data-sort'));
    var total = $('#collapse-shipping-address .co-form-group').length;
    if (sort >= 0 && sort <= total - 2) {
        $('#collapse-shipping-address .co-form-group').eq(sort + 2).before(this);
    } else if (sort > total - 2) {
        $('#collapse-shipping-address .co-form-group:last').after(this);
    } else {
        $('#collapse-shipping-address .co-form-group:first').before(this);
    }
});

// File upload
$('#collapse-shipping-address button[id^="button-shipping-custom-field"]').on('click', function() {
    var element = this;
    $('#form-upload').remove();
    $('body').prepend('<form enctype="multipart/form-data" id="form-upload" style="display:none;"><input type="file" name="file" /></form>');
    $('#form-upload input[name="file"]').trigger('click');
    if (typeof timer !== 'undefined') clearInterval(timer);
    timer = setInterval(function() {
        if ($('#form-upload input[name="file"]').val() !== '') {
            clearInterval(timer);
            $.ajax({
                url: 'index.php?route=tool/upload',
                type: 'post',
                dataType: 'json',
                data: new FormData($('#form-upload')[0]),
                cache: false,
                contentType: false,
                processData: false,
                success: function(json) {
                    $(element).parent().find('.text-danger').remove();
                    if (json['error']) $(element).parent().find('input[name^="custom_field"]').after('<div class="text-danger" style="font-size:11px;color:var(--accent);">' + json['error'] + '</div>');
                    if (json['success']) { alert(json['success']); $(element).parent().find('input[name^="custom_field"]').val(json['code']); }
                },
                error: function(xhr, a, e) { alert(e); }
            });
        }
    }, 500);
});

// Datetimepicker
$('.date').datetimepicker({ language: '{{ datepicker }}', pickTime: false });
$('.time').datetimepicker({ language: '{{ datepicker }}', pickDate: false });
$('.datetime').datetimepicker({ language: '{{ datepicker }}', pickDate: true, pickTime: true });

// Country → zones
$('#collapse-shipping-address select[name="country_id"]').on('change', function() {
    $.ajax({
        url: 'index.php?route=checkout/checkout/country&country_id=' + this.value,
        dataType: 'json',
        beforeSend: function() { $('#collapse-shipping-address select[name="country_id"]').prop('disabled', true); },
        complete:   function() { $('#collapse-shipping-address select[name="country_id"]').prop('disabled', false); },
        success: function(json) {
            var html = '<option value="">— Выберите —</option>';
            if (json['zone'] && json['zone'] !== '') {
                for (var i = 0; i < json['zone'].length; i++) {
                    html += '<option value="' + json['zone'][i]['zone_id'] + '"';
                    if (json['zone'][i]['zone_id'] == '{{ zone_id }}') html += ' selected="selected"';
                    html += '>' + json['zone'][i]['name'] + '</option>';
                }
            } else {
                html += '<option value="0" selected="selected">{{ text_none }}</option>';
            }
            $('#collapse-shipping-address select[name="zone_id"]').html(html);
        },
        error: function(xhr, a, e) { alert(e); }
    });
});
$('#collapse-shipping-address select[name="country_id"]').trigger('change');
</script>
