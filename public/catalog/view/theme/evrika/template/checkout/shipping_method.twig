{% if error_warning %}
<div class="alert-bar alert-bar--err" style="margin-bottom:12px;">{{ error_warning }}</div>
{% endif %}

{% set has_quotes = false %}
{% if shipping_methods %}
  {% for shipping_method in shipping_methods %}
    {% if not shipping_method.error and shipping_method.quote %}
      {% set has_quotes = true %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if has_quotes %}
<div class="delivery-options" style="margin-bottom:16px;">
  {% for shipping_method in shipping_methods %}
  {% if not shipping_method.error and shipping_method.quote %}

  {% if shipping_method.title %}
  <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-60);margin:10px 0 6px;">{{ shipping_method.title }}</div>
  {% endif %}

  {% for quote in shipping_method.quote %}
  {% set is_pickup = quote.code starts with 'pickup' or 'pickup' in quote.code %}
  <label class="delivery-option">
    {% if quote.code == code or not code %}
    {% set code = quote.code %}
    <input type="radio" name="shipping_method" value="{{ quote.code }}" checked="checked" />
    {% else %}
    <input type="radio" name="shipping_method" value="{{ quote.code }}" />
    {% endif %}
    <div class="delivery-option-card">
      <div class="delivery-option-radio"></div>
      <div class="delivery-option-icon">
        {% if is_pickup %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="22" height="22" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        {% else %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="22" height="22" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        {% endif %}
      </div>
      <div class="delivery-option-info">
        <div class="delivery-option-name">{{ quote.title }}</div>
        {% if is_pickup and (store_address or store_open) %}
        <div class="delivery-option-desc">
          {% if store_address %}{{ store_address }}{% endif %}
          {% if store_address and store_open %}<br>{% endif %}
          {% if store_open %}{{ store_open }}{% endif %}
        </div>
        {% endif %}
      </div>
      {% set is_free = quote.cost is defined and quote.cost == 0 %}
      <div class="delivery-option-price{% if is_free %} free{% endif %}">
        {% if is_free %}Бесплатно{% else %}{{ quote.text }}{% endif %}
      </div>
    </div>
  </label>
  {% endfor %}

  {% endif %}
  {% endfor %}
</div>
{% else %}
<div style="font-size:13px;color:var(--ink-60);padding:10px 0 16px;">Нет доступных способов доставки.</div>
{% endif %}

<div class="co-form-group" style="margin-bottom:16px;">
  <label for="input-shipping-comment">Комментарий к заказу</label>
  <textarea name="comment" id="input-shipping-comment" rows="3" placeholder="Уточнения по доставке, удобное время и т.д.">{{ comment }}</textarea>
</div>

<div class="co-step-actions">
  <button type="button" id="button-shipping-method" class="btn btn-primary">
    Продолжить
  </button>
</div>
