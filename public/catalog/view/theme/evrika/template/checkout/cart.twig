{{ header }}
<main>
<div class="wrap">

  {# Хлебные крошки #}
  <nav class="breadcrumb" aria-label="Хлебные крошки">
    {% for breadcrumb in breadcrumbs %}
      {% if loop.last %}
        <span class="bc-current" aria-current="page">{{ breadcrumb.text }}</span>
      {% else %}
        <a href="{{ breadcrumb.href }}">{% if loop.first %}Главная{% else %}{{ breadcrumb.text }}{% endif %}</a>
        <span class="bc-sep" aria-hidden="true">›</span>
      {% endif %}
    {% endfor %}
  </nav>

  {# Системные сообщения #}
  {% if error_warning %}
  <div class="alert-bar alert-bar--err" role="alert">{{ error_warning }}</div>
  {% endif %}
  {% if success %}
  <div class="alert-bar alert-bar--ok" role="alert">{{ success }}</div>
  {% endif %}
  {% if attention %}
  <div class="alert-bar alert-bar--info" role="alert">{{ attention | raw }}</div>
  {% endif %}

  {# Заголовок страницы #}
  {% set cart_cnt = products | length %}
  <div class="cart-page-head">
    <h1 class="cart-page-title">{{ heading_title }}</h1>
    <span class="cart-page-count" id="cartCount">
      {% if cart_cnt % 10 == 1 and cart_cnt % 100 != 11 %}{{ cart_cnt }}&nbsp;товар{% elseif cart_cnt % 10 >= 2 and cart_cnt % 10 <= 4 and (cart_cnt % 100 < 10 or cart_cnt % 100 >= 20) %}{{ cart_cnt }}&nbsp;товара{% else %}{{ cart_cnt }}&nbsp;товаров{% endif %}
    </span>
  </div>

  {# ================================================================
     ОСНОВНОЙ ЛЕЙАУТ — список товаров + сводка
     ================================================================ #}
  <div class="cart-layout" id="cartLayout">

    {# ── ЛЕВАЯ КОЛОНКА — список товаров ── #}
    <div>

      {# Поиск по корзине #}
      <div class="cart-search-bar">
        <div class="cart-search-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
          <input type="text" id="cartSearch" class="cart-search-input" placeholder="Поиск по корзине — название, код, бренд...">
          <button class="cart-search-clear" id="cartSearchClear" aria-label="Очистить" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="cart-search-status" id="cartSearchStatus"></div>
      </div>

      <div class="cart-items-wrap" id="cartItemsWrap">

        {# Шапка таблицы (скрыта на мобильных) #}
        <div class="cart-table-head" aria-hidden="true">
          <div></div>
          <div></div>
          <div>Товар</div>
          <div class="col-center">Количество</div>
          <div class="col-right">Цена / шт.</div>
          <div class="col-right">Итого</div>
          <div></div>
        </div>

        {# Список товаров #}
        {% for product in products %}
        <div class="cart-item" data-cart-id="{{ product.cart_id }}" data-unit-price="{{ product.price ? product.price : '' }}" data-price-raw="{{ product.price_raw is defined ? product.price_raw : 0 }}">

          {# Чекбокс выбора #}
          <div class="cart-check">
            <input type="checkbox" aria-label="Выбрать товар">
            <span class="cart-check-box"></span>
          </div>

          {# Изображение #}
          <a href="{{ product.href }}" class="cart-img" aria-label="{{ product.name }}">
            {% if product.thumb %}
              <img src="{{ product.thumb }}" alt="{{ product.name }}" loading="lazy">
            {% else %}
              <svg viewBox="0 0 80 80" fill="none"><rect x="15" y="8" width="50" height="64" rx="6" fill="#EBF5EF"/><path d="M25 20h30M25 30h20" stroke="#9ABFAA" stroke-width="3" stroke-linecap="round"/></svg>
            {% endif %}
          </a>

          {# Информация о товаре #}
          <div class="cart-info">
            <a href="{{ product.href }}" class="cart-name">{{ product.name }}</a>
            <div class="cart-sku-row">
              {% if product.model %}
                <span class="cart-sku-label">Код:</span>
                <span class="cart-sku-val">{{ product.model }}</span>
              {% endif %}
            </div>
            {% if product.manufacturer is defined and product.manufacturer %}
              <div class="cart-brand-row">{{ product.manufacturer }}</div>
            {% endif %}
            {% if product.option %}
              {% for option in product.option %}
              <div class="cart-option-row">
                <span class="cart-sku-label">{{ option.name }}:</span>
                <span>{{ option.value }}</span>
              </div>
              {% endfor %}
            {% endif %}
            {% if not product.stock %}
              <span class="cart-out-of-stock">Нет в наличии</span>
            {% endif %}
          </div>

          {# Контроль количества #}
          <div class="cart-qty">
            <div class="qty-ctrl">
              <button class="qty-btn minus" aria-label="Уменьшить" type="button">−</button>
              <input class="qty-input" type="number"
                name="quantity[{{ product.cart_id }}]"
                value="{{ product.quantity }}"
                min="{{ product.minimum is defined ? product.minimum|default(1) : 1 }}"
                aria-label="Количество"
                data-cart-id="{{ product.cart_id }}">
              <button class="qty-btn plus" aria-label="Увеличить" type="button">+</button>
            </div>
          </div>

          {# Цена за единицу #}
          <div class="cart-price">
            {% if product.price %}
              <span class="cart-price-val">{{ product.price }}</span>
              <span class="cart-price-unit">за шт.</span>
            {% endif %}
          </div>

          {# Итого по строке #}
          <div class="cart-row-total">
            {% if product.total %}{{ product.total }}{% endif %}
          </div>

          {# Кнопка удалить #}
          <button class="cart-delete" aria-label="Удалить товар из корзины" type="button"
            onclick="cartItemRemove('{{ product.cart_id }}', this)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
          </button>

        </div>
        {% endfor %}

        {# Нижняя панель: выбрать всё + удалить выбранные #}
        <div class="cart-table-foot">
          <div class="cart-select-all-label" id="selectAllLabel" role="button" tabindex="0" aria-label="Выбрать все товары">
            <input type="checkbox" id="selectAll">
            <span class="cart-check-box" id="selectAllBox"></span>
            <span>Выбрать всё</span>
          </div>
          <button class="btn-delete-selected" id="deleteSelected" type="button"></button>
        </div>

      </div><!-- /cart-items-wrap -->
    </div><!-- /левая колонка -->

    {# ── ПРАВАЯ КОЛОНКА — сводка заказа ── #}
    <aside class="cart-summary" aria-label="Сводка заказа">

      <div class="cart-summary-title">Ваш заказ</div>

      {# Итоговые строки из OcStore #}
      <div class="summary-rows" id="summaryRows">
        {% set totals_count = totals | length %}
        {% for total in totals %}
        <div class="summary-row{% if loop.last %} total-row{% endif %}">
          <span>
            {{ total.title }}
            {% if loop.first and totals_count > 1 %}
            (<span id="summaryItemCount">{% if cart_cnt % 10 == 1 and cart_cnt % 100 != 11 %}{{ cart_cnt }}&nbsp;товар{% elseif cart_cnt % 10 >= 2 and cart_cnt % 10 <= 4 and (cart_cnt % 100 < 10 or cart_cnt % 100 >= 20) %}{{ cart_cnt }}&nbsp;товара{% else %}{{ cart_cnt }}&nbsp;товаров{% endif %}</span>)
            {% endif %}
          </span>
          <span{% if loop.last %} class="val" id="summaryTotal"{% endif %}>{{ total.text }}</span>
        </div>
        {% endfor %}
      </div>

      {# Кнопки действий #}
      <div class="summary-actions">
        <a class="btn-checkout" href="{{ checkout }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Оформить заказ
        </a>
        <a class="btn-continue" href="{{ continue }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          Продолжить покупки
        </a>
        <div class="summary-secure">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Безопасная оплата
        </div>
      </div>

    </aside>

  </div><!-- /cart-layout -->

  {# Рекомендуемые товары (content_bottom из Layout) #}
  {% if content_bottom %}
  <section class="cart-recommend" aria-label="Рекомендуем добавить">
    <div class="section-head">
      <h2 class="section-title">Рекомендуем добавить</h2>
      <a class="section-more" href="{{ continue }}">Смотреть все →</a>
    </div>
    <div class="recommend-slider-wrap">
      <button class="rec-slider-prev" aria-label="Назад" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <div class="recommend-slider">
        {{ content_bottom }}
      </div>
      <button class="rec-slider-next" aria-label="Вперёд" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </section>
  {% endif %}

</div><!-- /wrap -->
</main>

<script src="catalog/view/theme/evrika/js/cart-page.js" type="text/javascript"></script>

{{ footer }}
