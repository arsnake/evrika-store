<div class="co-auth-cols">

  {# ── ЛЕВАЯ КОЛОНКА: Вход ── #}
  <div class="co-auth-col">
    <h3 class="co-auth-title">Уже есть аккаунт?</h3>
    <p class="co-auth-desc">Войдите, чтобы использовать сохранённые адреса и историю заказов.</p>

    <div class="co-form-group" id="fg-email">
      <label for="input-email">E-mail <span class="co-req">*</span></label>
      <input type="text" name="email" value="" placeholder="your@email.com" id="input-email" autocomplete="email" />
    </div>

    <div class="co-form-group" id="fg-password">
      <label for="input-password">Пароль <span class="co-req">*</span></label>
      <input type="password" name="password" value="" placeholder="Пароль" id="input-password" autocomplete="current-password" />
    </div>

    <div class="co-auth-links">
      <a href="{{ forgotten }}">Забыли пароль?</a>
    </div>

    <button type="button" id="button-login" class="btn btn-primary" style="width:100%;">
      Войти
    </button>
  </div>

  {# ── РАЗДЕЛИТЕЛЬ ── #}
  <div class="co-auth-divider"><span>или</span></div>

  {# ── ПРАВАЯ КОЛОНКА: Новый покупатель ── #}
  <div class="co-auth-col">
    <h3 class="co-auth-title">Новый покупатель</h3>
    <p class="co-auth-desc">Заполните данные для оформления заказа. Личный кабинет будет создан автоматически.</p>

    <div class="co-form-grid--2" style="margin-bottom:0;">
      <div class="co-form-group" id="fg-reg-firstname">
        <label for="input-reg-firstname">Имя <span class="co-req">*</span></label>
        <input type="text" id="input-reg-firstname" name="reg_firstname" placeholder="Иван" autocomplete="given-name" />
      </div>
      <div class="co-form-group" id="fg-reg-lastname">
        <label for="input-reg-lastname">Фамилия</label>
        <input type="text" id="input-reg-lastname" name="reg_lastname" placeholder="Иванов" autocomplete="family-name" />
      </div>
    </div>

    <div class="co-form-group" id="fg-reg-email">
      <label for="input-reg-email">E-mail <span class="co-req">*</span></label>
      <input type="text" id="input-reg-email" name="reg_email" placeholder="your@email.com" autocomplete="email" />
    </div>

    <div class="co-form-group" id="fg-reg-telephone">
      <label for="input-reg-telephone">Телефон</label>
      <input type="text" id="input-reg-telephone" name="reg_telephone" placeholder="+7 (___) ___-__-__" autocomplete="tel" />
    </div>

    <button type="button" id="button-new-customer" class="btn btn-primary" style="width:100%;margin-top:4px;">
      Продолжить
    </button>
  </div>

</div>
