{% if error_warning %}
<div class="alert-bar alert-bar--err" style="margin-bottom:12px;">{{ error_warning }}</div>
{% endif %}

{% if payment_methods %}
<div class="payment-options" style="margin-bottom:16px;">
  {% for payment_method in payment_methods %}
  <label class="payment-option">
    {% if payment_method.code == code or not code %}
    {% set code = payment_method.code %}
    <input type="radio" name="payment_method" value="{{ payment_method.code }}" checked="checked" />
    {% else %}
    <input type="radio" name="payment_method" value="{{ payment_method.code }}" />
    {% endif %}
    <div class="payment-option-card">
      <div class="payment-option-radio"></div>
      <div class="payment-option-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
      </div>
      <div class="payment-option-info">
        <div class="payment-option-name">{{ payment_method.title }}</div>
        {% if payment_method.terms %}
        <div class="payment-option-desc">{{ payment_method.terms }}</div>
        {% endif %}
      </div>
    </div>
  </label>
  {% endfor %}
</div>
{% else %}
<div style="font-size:13px;color:var(--ink-60);padding:10px 0 16px;">Нет доступных способов оплаты.</div>
{% endif %}

<div class="co-form-group" style="margin-bottom:16px;">
  <label for="input-payment-comment">Комментарий к заказу</label>
  <textarea name="comment" id="input-payment-comment" rows="3" placeholder="Пожелания, реквизиты для счёта и т.д.">{{ comment }}</textarea>
</div>

{% if text_agree %}
<div class="co-agree-wrap" style="margin-bottom:16px;">
  <label class="co-agree-label">
    {% if agree %}
    <input type="checkbox" name="agree" value="1" checked="checked" />
    {% else %}
    <input type="checkbox" name="agree" value="1" />
    {% endif %}
    <span class="co-agree-box">
      <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6l3 3 5-5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    <span>{{ text_agree }}</span>
  </label>
</div>
{% endif %}

<div class="co-step-actions">
  <button type="button" id="button-payment-method" class="btn btn-primary">
    Продолжить
  </button>
</div>
