{% if not redirect %}

{# ── ТОВАРЫ ── #}
<div class="co-confirm-items" style="margin-bottom:16px;">
  <div class="co-confirm-items-title">Товары в заказе</div>

  {% for product in products %}
  <div class="co-confirm-item">
    <div class="co-confirm-item-img">
      {% if product.thumb %}
        <img src="{{ product.thumb }}" alt="{{ product.name }}" width="44" height="44" style="object-fit:contain;border-radius:var(--radius-s);">
      {% else %}
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:var(--ink-30)"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      {% endif %}
    </div>
    <div class="co-confirm-item-info">
      <div class="co-confirm-item-name">{{ product.name }}</div>
      {% if product.model %}
      <div class="co-confirm-item-sku">Арт. {{ product.model }}</div>
      {% endif %}
      {% for option in product.option %}
      <div class="co-confirm-item-sku">{{ option.name }}: {{ option.value }}</div>
      {% endfor %}
    </div>
    <div class="co-confirm-item-qty">× {{ product.quantity }}</div>
    <div class="co-confirm-item-total">{{ product.total }}</div>
  </div>
  {% endfor %}

  {% for voucher in vouchers %}
  <div class="co-confirm-item">
    <div class="co-confirm-item-img">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:var(--ink-30)"><path d="M20 12v7a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-7"/><path d="M21 5H3v7h18V5z"/><path d="M12 5v7"/></svg>
    </div>
    <div class="co-confirm-item-info">
      <div class="co-confirm-item-name">{{ voucher.description }}</div>
    </div>
    <div class="co-confirm-item-qty">× 1</div>
    <div class="co-confirm-item-total">{{ voucher.amount }}</div>
  </div>
  {% endfor %}
</div>

{# ── ИТОГИ ── #}
{% if totals %}
<div class="co-confirm-totals">
  {% for total in totals %}
  <div class="co-confirm-total-row{% if loop.last %} co-confirm-total-final{% endif %}">
    <span>{{ total.title }}</span>
    <span>{{ total.text }}</span>
  </div>
  {% endfor %}
</div>
{% endif %}

{# ── ФОРМА ОПЛАТЫ (кнопка "Оформить заказ" приходит отсюда) ── #}
{{ payment }}

{% else %}
<script type="text/javascript">
location = '{{ redirect }}';
</script>
{% endif %}
