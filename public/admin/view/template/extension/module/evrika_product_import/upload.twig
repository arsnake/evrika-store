{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">

    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible">
        <i class="fa fa-exclamation-circle"></i>
        {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}

    {# Шаги #}
    <div class="panel panel-default">
      <div class="panel-body" style="padding: 12px 20px;">
        <div style="display:flex; gap:8px; align-items:center; font-size:13px;">
          <span style="background:#337ab7; color:#fff; border-radius:50%; width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center; font-weight:700;">1</span>
          <strong>{{ text_step1 }}</strong>
          <span style="color:#ccc; margin:0 4px;">→</span>
          <span style="background:#eee; color:#999; border-radius:50%; width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center;">2</span>
          <span style="color:#999;">{{ text_step2 }}</span>
          <span style="color:#ccc; margin:0 4px;">→</span>
          <span style="background:#eee; color:#999; border-radius:50%; width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center;">3</span>
          <span style="color:#999;">{{ text_step3 }}</span>
        </div>
      </div>
    </div>

    <div class="row">
      {# Форма загрузки файла #}
      <div class="col-md-6">
        <div class="panel panel-default">
          <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-upload"></i> {{ text_step1 }}</h3></div>
          <div class="panel-body">
            <p class="text-muted">{{ text_upload_intro }}</p>

            <form action="{{ action_upload }}" method="post" enctype="multipart/form-data">
              <input type="hidden" name="user_token" value="{{ user_token }}">
              <input type="hidden" name="preset_id" id="selected-preset-id" value="0">

              <div class="form-group">
                <label class="control-label">{{ entry_file }} <span class="required">*</span></label>
                <input type="file" name="import_file" accept=".xlsx,.xls" class="form-control" required>
                <span class="help-block">{{ text_file_hint }} <strong>.xlsx</strong> и <strong>.xls</strong>.</span>
              </div>

              <button type="submit" class="btn btn-primary btn-lg btn-block">
                <i class="fa fa-arrow-right"></i> {{ button_upload }}
              </button>
            </form>
          </div>
        </div>
      </div>

      {# Сохранённые пресеты #}
      <div class="col-md-6">
        <div class="panel panel-default">
          <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-bookmark"></i> {{ text_presets }}</h3></div>
          <div class="panel-body" style="padding:0;">
            {% if presets %}
              <table class="table table-hover" style="margin:0;">
                <tbody>
                  {% for preset in presets %}
                    <tr>
                      <td style="vertical-align:middle;">
                        <strong>{{ preset.name }}</strong>
                        <br><small class="text-muted">{{ preset.created_at }}</small>
                      </td>
                      <td style="text-align:right; vertical-align:middle; white-space:nowrap;">
                        <button type="button" class="btn btn-default btn-sm btn-use-preset"
                                data-id="{{ preset.preset_id }}" data-name="{{ preset.name }}">
                          <i class="fa fa-check"></i> {{ button_load_preset }}
                        </button>
                        <button type="button" class="btn btn-danger btn-sm btn-delete-preset"
                                data-id="{{ preset.preset_id }}" data-url="{{ action_preset_delete }}">
                          <i class="fa fa-trash"></i>
                        </button>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            {% else %}
              <p class="text-muted" style="padding:15px; margin:0;">{{ text_no_presets }}</p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    {# История импортов #}
    {% if logs %}
      <div class="panel panel-default">
        <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-history"></i> {{ text_import_history }}</h3></div>
        <div class="panel-body" style="padding:0;">
          <table class="table table-striped table-hover" style="margin:0;">
            <thead>
              <tr>
                <th>{{ column_date }}</th>
                <th>{{ column_file }}</th>
                <th class="text-center">{{ column_created }}</th>
                <th class="text-center">{{ column_updated }}</th>
                <th class="text-center">{{ column_skipped }}</th>
                <th class="text-center">{{ column_errors }}</th>
              </tr>
            </thead>
            <tbody>
              {% for log in logs %}
                <tr>
                  <td>{{ log.created_at }}</td>
                  <td><i class="fa fa-file-excel-o text-success"></i> {{ log.filename }}</td>
                  <td class="text-center"><span class="label label-success">{{ log.created_cnt }}</span></td>
                  <td class="text-center"><span class="label label-info">{{ log.updated_cnt }}</span></td>
                  <td class="text-center"><span class="label label-default">{{ log.skipped_cnt }}</span></td>
                  <td class="text-center">
                    {% if log.errors and log.errors != '[]' %}
                      <span class="label label-danger">!</span>
                    {% else %}
                      <span class="label label-default">0</span>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    {% endif %}

  </div>
</div>

<script>
// Выбор пресета для загрузки вместе с файлом
document.querySelectorAll('.btn-use-preset').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var id   = this.getAttribute('data-id');
    var name = this.getAttribute('data-name');
    document.getElementById('selected-preset-id').value = id;
    document.querySelectorAll('.btn-use-preset').forEach(function(b) {
      b.classList.remove('btn-success');
      b.classList.add('btn-default');
      b.innerHTML = '<i class="fa fa-check"></i> {{ button_load_preset }}';
    });
    this.classList.remove('btn-default');
    this.classList.add('btn-success');
    this.innerHTML = '<i class="fa fa-check-circle"></i> Будет применён';
  });
});

// Удаление пресета
document.querySelectorAll('.btn-delete-preset').forEach(function(btn) {
  btn.addEventListener('click', function() {
    if (!confirm('Удалить этот пресет?')) return;
    var id  = this.getAttribute('data-id');
    var url = this.getAttribute('data-url');
    var row = this.closest('tr');
    var fd  = new FormData();
    fd.append('preset_id', id);
    fd.append('user_token', '{{ user_token }}');
    fetch(url, { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.success) {
          row.remove();
        }
      });
  });
});
</script>

{{ footer }}
