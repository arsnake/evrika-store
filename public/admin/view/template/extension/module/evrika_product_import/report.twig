{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ action_new }}" class="btn btn-default">
          <i class="fa fa-upload"></i> {{ button_new_import }}
        </a>
        <a href="{{ action_catalog }}" class="btn btn-default">
          <i class="fa fa-list"></i> {{ button_go_catalog }}
        </a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">

    {# Шаги #}
    <div class="panel panel-default">
      <div class="panel-body" style="padding:12px 20px;">
        <div style="display:flex; gap:8px; align-items:center; font-size:13px;">
          <span style="background:#5cb85c; color:#fff; border-radius:50%; width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center;"><i class="fa fa-check" style="font-size:11px;"></i></span>
          <span style="color:#5cb85c;">{{ text_step1 }}</span>
          <span style="color:#ccc; margin:0 4px;">→</span>
          <span style="background:#5cb85c; color:#fff; border-radius:50%; width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center;"><i class="fa fa-check" style="font-size:11px;"></i></span>
          <span style="color:#5cb85c;">{{ text_step2 }}</span>
          <span style="color:#ccc; margin:0 4px;">→</span>
          <span style="background:#337ab7; color:#fff; border-radius:50%; width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center; font-weight:700;">3</span>
          <strong>{{ text_step3 }}</strong>
        </div>
      </div>
    </div>

    {# Файл #}
    <div class="alert alert-success">
      <i class="fa fa-check-circle"></i>
      <strong>{{ text_import_done }}</strong> — {{ result.filename }}
    </div>

    {# Сводка #}
    <div class="row" style="margin-bottom:20px;">
      <div class="col-sm-3">
        <div class="panel panel-success">
          <div class="panel-body text-center">
            <div style="font-size:36px; font-weight:700; color:#3c763d;">{{ result.created }}</div>
            <div style="font-size:13px; color:#3c763d;">{{ text_result_created }}</div>
          </div>
        </div>
      </div>
      <div class="col-sm-3">
        <div class="panel panel-info">
          <div class="panel-body text-center">
            <div style="font-size:36px; font-weight:700; color:#31708f;">{{ result.updated }}</div>
            <div style="font-size:13px; color:#31708f;">{{ text_result_updated }}</div>
          </div>
        </div>
      </div>
      <div class="col-sm-3">
        <div class="panel panel-warning">
          <div class="panel-body text-center">
            <div style="font-size:36px; font-weight:700; color:#8a6d3b;">{{ result.skipped }}</div>
            <div style="font-size:13px; color:#8a6d3b;">{{ text_result_skipped }}</div>
          </div>
        </div>
      </div>
      <div class="col-sm-3">
        <div class="panel {{ error_count > 0 ? 'panel-danger' : 'panel-default' }}">
          <div class="panel-body text-center">
            <div style="font-size:36px; font-weight:700; color:{{ error_count > 0 ? '#a94442' : '#777' }};">{{ error_count }}</div>
            <div style="font-size:13px; color:{{ error_count > 0 ? '#a94442' : '#777' }};">{{ text_result_errors }}</div>
          </div>
        </div>
      </div>
    </div>

    {# Таблица созданных товаров #}
    {% set has_created = false %}
    {% for row in rows %}{% if row.status == 'created' %}{% set has_created = true %}{% endif %}{% endfor %}

    {% if has_created %}
    <div class="panel panel-success">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-plus-circle"></i> Созданные товары ({{ result.created }})</h3>
      </div>
      <div class="panel-body" style="padding:0; overflow-x:auto;">
        <table class="table table-striped table-condensed" style="margin:0;">
          <thead>
            <tr style="background:#dff0d8;">
              <th style="width:50px;">Строка</th>
              <th>Название</th>
              <th style="width:120px;">Код (model)</th>
              <th>Категории</th>
              <th style="width:150px;">Действия</th>
            </tr>
          </thead>
          <tbody>
            {% for row in rows %}
            {% if row.status == 'created' %}
            <tr>
              <td><span class="label label-success">{{ row.row }}</span></td>
              <td>{{ row.name }}</td>
              <td><code>{{ row.model }}</code></td>
              <td>
                {% if row.categories %}
                  {% for cat in row.categories %}
                    <span class="label label-default" style="margin:1px 2px; display:inline-block;">{{ cat }}</span>
                  {% endfor %}
                {% else %}
                  <span style="color:#999;">—</span>
                {% endif %}
              </td>
              <td>
                {% if row.product_id %}
                <a href="{{ url_catalog }}?product_id={{ row.product_id }}" target="_blank" class="btn btn-xs btn-default" title="Просмотр в магазине">
                  <i class="fa fa-eye"></i>
                </a>
                <a href="{{ action_edit_product }}&amp;product_id={{ row.product_id }}" class="btn btn-xs btn-primary" title="Редактировать">
                  <i class="fa fa-pencil"></i>
                </a>
                {% endif %}
              </td>
            </tr>
            {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endif %}

    {# Таблица обновлённых товаров #}
    {% set has_updated = false %}
    {% for row in rows %}{% if row.status == 'updated' %}{% set has_updated = true %}{% endif %}{% endfor %}

    {% if has_updated %}
    <div class="panel panel-info">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-refresh"></i> Обновлённые товары ({{ result.updated }})</h3>
      </div>
      <div class="panel-body" style="padding:0; overflow-x:auto;">
        <table class="table table-striped table-condensed" style="margin:0;">
          <thead>
            <tr style="background:#d9edf7;">
              <th style="width:50px;">Строка</th>
              <th>Название</th>
              <th style="width:120px;">Код (model)</th>
              <th>Категории</th>
              <th style="width:100px;">Действия</th>
            </tr>
          </thead>
          <tbody>
            {% for row in rows %}
            {% if row.status == 'updated' %}
            <tr>
              <td><span class="label label-info">{{ row.row }}</span></td>
              <td>{{ row.name }}</td>
              <td><code>{{ row.model }}</code></td>
              <td>
                {% if row.categories %}
                  {% for cat in row.categories %}
                    <span class="label label-default" style="margin:1px 2px; display:inline-block;">{{ cat }}</span>
                  {% endfor %}
                {% else %}
                  <span style="color:#999;">—</span>
                {% endif %}
              </td>
              <td>
                {% if row.product_id %}
                <a href="{{ action_edit_product }}&amp;product_id={{ row.product_id }}" class="btn btn-xs btn-primary" title="Редактировать">
                  <i class="fa fa-pencil"></i> Ред.
                </a>
                {% endif %}
              </td>
            </tr>
            {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endif %}

    {# Таблица пропущенных и ошибок #}
    {% set has_problems = false %}
    {% for row in rows %}{% if row.status == 'skipped' or row.status == 'error' %}{% set has_problems = true %}{% endif %}{% endfor %}

    {% if has_problems %}
    <div class="panel panel-warning">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Пропущенные строки и ошибки</h3>
      </div>
      <div class="panel-body" style="padding:0; overflow-x:auto;">
        <table class="table table-striped table-condensed" style="margin:0;">
          <thead>
            <tr style="background:#fcf8e3;">
              <th style="width:60px;">Строка</th>
              <th style="width:80px;">Тип</th>
              <th>Причина / Детали</th>
            </tr>
          </thead>
          <tbody>
            {% for row in rows %}
            {% if row.status == 'skipped' or row.status == 'error' %}
            <tr class="{{ row.status == 'error' ? 'danger' : '' }}">
              <td>{{ row.row }}</td>
              <td>
                {% if row.status == 'error' %}
                  <span class="label label-danger">Ошибка</span>
                {% else %}
                  <span class="label label-warning">Пропущено</span>
                {% endif %}
              </td>
              <td style="word-break:break-word;">{{ row.message }}</td>
            </tr>
            {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endif %}

    {# Если нет детальных данных (старый формат) — показываем ошибки из текстового лога #}
    {% if not rows and error_count > 0 %}
    <div class="panel panel-danger">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-exclamation-circle"></i> {{ text_errors_detail }}</h3></div>
      <div class="panel-body" style="padding:0;">
        <table class="table table-condensed" style="margin:0;">
          <thead><tr><th>Описание ошибки</th></tr></thead>
          <tbody>
            {% for error in result.errors %}
            <tr class="danger"><td>{{ error }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endif %}

    {% if error_count > 0 %}
    <p>
      <a href="{{ action_download_errors }}" class="btn btn-default btn-sm">
        <i class="fa fa-download"></i> {{ button_download_errors }}
      </a>
    </p>
    {% endif %}

  </div>
</div>
{{ footer }}
