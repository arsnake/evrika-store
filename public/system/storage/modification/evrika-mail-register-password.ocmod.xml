<?xml version="1.0" encoding="UTF-8"?>
<modification>
    <name>Evrika Mail Register Password</name>
    <code>evrika-mail-register-password</code>
    <version>1.0</version>
    <author>Evrika</author>
    <link></link>

    <file path="catalog/controller/mail/register.php">

        <!-- Patch: pass email and password to register email template -->
        <operation>
            <search><![CDATA[$mail->setText($this->load->view('mail/register', $data));]]></search>
            <add position="before"><![CDATA[$data['email']    = isset($args[0]['email'])    ? $args[0]['email']    : '';
			$data['password'] = isset($args[0]['password']) ? $args[0]['password'] : '';
			]]></add>
        </operation>

    </file>

</modification>
