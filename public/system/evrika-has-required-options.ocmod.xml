<?xml version="1.0" encoding="UTF-8"?>
<modification>
    <name>Evrika: Module Cards — has_required_options field</name>
    <code>evrika-has-required-options</code>
    <version>1.0</version>
    <author>Evrika</author>
    <link></link>

    <!--
        Добавляет поле has_required_options в массив $data['products']
        во всех четырёх модульных контроллерах:
        latest, bestseller (основной цикл + fallback), featured, special.

        Поле используется в twig-карточках для скрытия кнопки «Купить сейчас»
        у товаров с обязательными опциями (которые нельзя выбрать в карточке).

        Зависимости:
          - latest.php    — уже пропатчен evrika-latest-extra-fields (добавлена строка 'stock')
          - bestseller.php — уже пропатчен evrika-bestseller-extra (добавлена строка 'stock')
          - featured.php  — оригинальный файл
          - special.php   — оригинальный файл
    -->

    <!-- ══════════════════════════════════════════════════════
         1. latest.php
         Ищем строку 'stock', добавленную evrika-latest-extra-fields
         ══════════════════════════════════════════════════════ -->
    <file path="catalog/controller/extension/module/latest.php">
        <operation>
            <search><![CDATA['stock'        => $result['quantity'] > 0,]]></search>
            <add position="after"><![CDATA[					'has_required_options' => (bool)$this->db->query("SELECT COUNT(*) AS cnt FROM `" . DB_PREFIX . "product_option` WHERE product_id = '" . (int)$result['product_id'] . "' AND required = '1'")->row['cnt'],]]></add>
        </operation>
    </file>

    <!-- ══════════════════════════════════════════════════════
         2. bestseller.php
         Op 1: основной цикл — строка 'stock' добавлена evrika-bestseller-extra Op3
         Op 2: fallback-цикл — строка 'stock' с переменной $fb
         ══════════════════════════════════════════════════════ -->
    <file path="catalog/controller/extension/module/bestseller.php">
        <!-- Основной цикл бестселлеров -->
        <operation>
            <search><![CDATA['stock'        => $result['quantity'] > 0,]]></search>
            <add position="after"><![CDATA[					'has_required_options' => (bool)$this->db->query("SELECT COUNT(*) AS cnt FROM `" . DB_PREFIX . "product_option` WHERE product_id = '" . (int)$result['product_id'] . "' AND required = '1'")->row['cnt'],]]></add>
        </operation>
        <!-- Fallback-цикл (случайные товары) -->
        <operation>
            <search><![CDATA['stock'        => $fb['quantity'] > 0,]]></search>
            <add position="after"><![CDATA[					'has_required_options' => (bool)$this->db->query("SELECT COUNT(*) AS cnt FROM `" . DB_PREFIX . "product_option` WHERE product_id = '" . (int)$fb['product_id'] . "' AND required = '1'")->row['cnt'],]]></add>
        </operation>
    </file>

    <!-- ══════════════════════════════════════════════════════
         3. featured.php
         Оригинальный файл — ищем строку href с $product_info
         ══════════════════════════════════════════════════════ -->
    <file path="catalog/controller/extension/module/featured.php">
        <operation>
            <search><![CDATA['href'        => $this->url->link('product/product', 'product_id=' . $product_info['product_id'])]]></search>
            <add position="after"><![CDATA[						'has_required_options' => (bool)$this->db->query("SELECT COUNT(*) AS cnt FROM `" . DB_PREFIX . "product_option` WHERE product_id = '" . (int)$product_info['product_id'] . "' AND required = '1'")->row['cnt'],]]></add>
        </operation>
    </file>

    <!-- ══════════════════════════════════════════════════════
         4. special.php
         Оригинальный файл — ищем строку href с $result
         ══════════════════════════════════════════════════════ -->
    <file path="catalog/controller/extension/module/special.php">
        <operation>
            <search><![CDATA['href'        => $this->url->link('product/product', 'product_id=' . $result['product_id'])]]></search>
            <add position="after"><![CDATA[					'has_required_options' => (bool)$this->db->query("SELECT COUNT(*) AS cnt FROM `" . DB_PREFIX . "product_option` WHERE product_id = '" . (int)$result['product_id'] . "' AND required = '1'")->row['cnt'],]]></add>
        </operation>
    </file>

    <!-- ══════════════════════════════════════════════════════
         5. category.php
         Пропатчен evrika-category-extra-fields (добавлена строка 'stock')
         Уникальная строка с оператором ||, отличает от других контроллеров
         ══════════════════════════════════════════════════════ -->
    <file path="catalog/controller/product/category.php">
        <operation>
            <search><![CDATA['stock'        => ($result['quantity'] > 0 || !$result['subtract']),]]></search>
            <add position="after"><![CDATA[					'has_required_options' => (bool)$this->db->query("SELECT COUNT(*) AS cnt FROM `" . DB_PREFIX . "product_option` WHERE product_id = '" . (int)$result['product_id'] . "' AND required = '1'")->row['cnt'],]]></add>
        </operation>
    </file>

</modification>
