<?xml version="1.0" encoding="utf-8"?>
<modification>
  <name>Evrika — Category Extra Fields (model, manufacturer, stock)</name>
  <code>evrika-category-extra-fields</code>
  <version>1.1</version>
  <author>Evrika</author>
  <link></link>

  <!--
    1. catalog/model/catalog/product.php — getProducts():
       Добавляет p.model, p.quantity, p.subtract и subquery-поле manufacturer
       в SELECT, чтобы контроллер категории мог передать эти поля в twig.

    2. catalog/controller/product/category.php:
       Добавляет model, manufacturer, stock в $data['products'][].

    ВАЖНО: Строка 'stock' заканчивается запятой, т.к. следующий OCMod
    (evrika-has-required-options) добавляет has_required_options ПОСЛЕ неё.
  -->

  <!-- ═══ 1. Модель: дополнительные поля в SELECT getProducts() ═══ -->
  <file path="catalog/model/catalog/product.php">
    <operation>
      <search><![CDATA[ps.price ASC LIMIT 1) AS special";]]></search>
      <add position="replace" trim="true"><![CDATA[ps.price ASC LIMIT 1) AS special, p.model, p.quantity, p.subtract, (SELECT m2.name FROM " . DB_PREFIX . "manufacturer m2 WHERE m2.manufacturer_id = p.manufacturer_id LIMIT 1) AS manufacturer";]]></add>
    </operation>
  </file>

  <!-- ═══ 2. Контроллер: передать model, manufacturer, stock в twig ═══ -->
  <file path="catalog/controller/product/category.php">
    <operation>
      <search><![CDATA['href'        => $this->url->link('product/product', 'path=' . $this->request->get['path'] . '&product_id=' . $result['product_id'] . $url)]]></search>
      <add position="replace" trim="true"><![CDATA['href'        => $this->url->link('product/product', 'path=' . $this->request->get['path'] . '&product_id=' . $result['product_id'] . $url),
					'model'        => $result['model'],
					'manufacturer' => $result['manufacturer'],
					'stock'        => ($result['quantity'] > 0 || !$result['subtract']),]]></add>
    </operation>
  </file>

</modification>
