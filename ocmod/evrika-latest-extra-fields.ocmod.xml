<?xml version="1.0" encoding="UTF-8"?>
<modification>
    <name>Evrika: Latest Module — model, manufacturer, stock fields, in-stock filter</name>
    <code>evrika-latest-extra-fields</code>
    <version>1.2</version>
    <author>Evrika</author>
    <link></link>

    <!--
        1. catalog/model/catalog/product.php — getLatestProducts():
           Добавляет AND (p.subtract = '0' OR p.quantity > '0') в SQL,
           чтобы LIMIT применялся уже к отфильтрованной выборке.

        2. catalog/controller/extension/module/latest.php:
           Добавляет model, manufacturer, stock в $data['products'][].
    -->

    <!-- ═══ 1. Модель: фильтр по наличию в SQL ═══ -->
    <file path="catalog/model/catalog/product.php">
        <operation>
            <search><![CDATA[ORDER BY p.date_added DESC LIMIT " . (int)$limit);]]></search>
            <add position="replace" trim="true"><![CDATA[AND (p.subtract = '0' OR p.quantity > '0') ORDER BY p.date_added DESC LIMIT " . (int)$limit);]]></add>
        </operation>
    </file>

    <!-- ═══ 2. Контроллер: дополнительные поля ═══ -->
    <file path="catalog/controller/extension/module/latest.php">
        <operation>
            <search><![CDATA['href'        => $this->url->link('product/product', 'product_id=' . $result['product_id'])]]></search>
            <add position="replace" trim="true"><![CDATA[
					'href'         => $this->url->link('product/product', 'product_id=' . $result['product_id']),
					'model'        => $result['model'],
					'manufacturer' => $result['manufacturer'],
					'stock'        => $result['quantity'] > 0,]]></add>
        </operation>
    </file>
</modification>
